  "date": "2026-11-22",
  "title": "Select bounded Linux sync scheduling, shuffle merges, and indexed quotas",
  "subsystem": "execution",
  "question": "Which independently verified complete jobs justify automatic native selection?",
  "disposition": "adopt",
  "delivery": "default",
  "outcome": "favorable",
  "summary": "Default Linux Run applies the measured 8,192\u201316,384-file sync range, terminal Uniform reader tiers, and a 1,000-destination exact quota rule. Lower controls keep their ordinary routes.",
  "scope": {
    "runtimes": [
      "native-linux"
    ],
    "workloads": [
      "2 GiB Interleaved sync jobs, 8 GiB Uniform followed by Balanced, and 4.2-million-row standalone exact assignment."
    ],
    "measurement": "complete-run"
  },
  "validation": {
    "runtimes": [
      "native-linux"
    ],
    "summary": "Independent byte, field, quota, group, and cleanup checks pass for scoped paired jobs. A feature-free CLI smoke verifies the 1 GiB automatic sync tier and 8,192 files."
  },
  "limitations": [
    "One WSL ext4 host. The integrated merge comparison includes terminal publication; earlier feature-only records isolate merge behavior."
  ],
  "exclusions": [
    "1,024-group or 1.05-million-row indexed scope, non-Linux runtimes, and a separate 40 GiB short-tail selector."
  ],
