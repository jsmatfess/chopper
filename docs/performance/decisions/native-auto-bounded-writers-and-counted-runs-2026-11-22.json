{
  "schema_version": 1,
  "id": "native-auto-bounded-writers-and-counted-runs-2026-11-22",
  "date": "2026-11-22",
  "title": "Select bounded writers and counted native Run paths automatically",
  "subsystem": "execution",
  "question": "Which independently verified complete jobs justify automatic native selection?",
  "disposition": "adopt",
  "delivery": "default",
  "outcome": "favorable",
  "summary": "Bounded Partition, configured writers, two-step chains, retained stratified exact and counted Balanced variants pass paired complete-job gates in the measured native regimes.",
  "scope": {
    "runtimes": [
      "native-linux",
      "native-windows"
    ],
    "workloads": [
      "2 GiB configured fanout, counted and composed jobs, 293 MiB Partition lower control and scoped Linux wide UTF-16LE output."
    ],
    "measurement": "complete-run"
  },
  "validation": {
    "runtimes": [
      "native-linux",
      "native-windows"
    ],
    "summary": "Exact field and row conservation, encounter and composed order, strict byte caps, quotas, and cleanup pass. Native shared admission and staged hosted contracts pass."
  },
  "limitations": [
    "One physical host. Linux uses WSL ext4 and Windows uses actual native NTFS. Zstandard adoption covers a highly compressible checksummed frame."
  ],
  "exclusions": [
    "Broader compressed containers, unknown writer bounds, observed native direct routes and WASI."
  ],
  "reopen_when": null,
