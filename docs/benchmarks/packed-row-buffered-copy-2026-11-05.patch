+    fn complete_buffered_frames_match_serial_decode_errors_positions_and_grants() -> Result<()> {
+        struct Windows {
+            data: Vec<u8>,
+            position: usize,
+            windows: Vec<usize>,
+            calls: usize,
+            visible: usize,
+        }
+        impl Read for Windows {
+            fn read(&mut self, output: &mut [u8]) -> io::Result<usize> {
+                let available = self.fill_buf()?;
+                let length = available.len().min(output.len());
+                output[..length].copy_from_slice(&available[..length]);
+                self.consume(length);
+                Ok(length)
+            }
+        }
+        impl BufRead for Windows {
+            fn fill_buf(&mut self) -> io::Result<&[u8]> {
+                self.visible = self.windows[self.calls % self.windows.len()]
+                    .min(self.data.len() - self.position);
+                self.calls += 1;
+                Ok(&self.data[self.position..self.position + self.visible])
+            }
+            fn consume(&mut self, length: usize) {
+                assert!(length <= self.visible);
+                self.position += length;
+                self.visible -= length;
+            }
+        }
