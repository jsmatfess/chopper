+        let mut oversized = frame.clone();
+        oversized[body..body + 8].copy_from_slice(&4097u64.to_le_bytes());
+        cases.push((oversized, false));
+        let mut count = frame.clone();
+        count[body - 8..body].copy_from_slice(&u64::MAX.to_le_bytes());
