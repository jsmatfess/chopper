+/// Validate one borrowed window without consuming bytes or allocating. A miss
+/// leaves the caller's sequential decoder responsible for every error.
+fn buffered_fields_length(buffer: &[u8], count: u64, mut remaining: usize) -> Option<usize> {
+    if count > (buffer.len() / 8) as u64 {
+        return None;
+    }
+    let mut position = 0usize;
+    for _ in 0..count {
+        let start = position.checked_add(8)?;
+        let length = u64::from_le_bytes(buffer.get(position..start)?.try_into().ok()?);
+        if length > remaining as u64 {
+            return None;
+        }
+        let length = length as usize;
+        position = start.checked_add(length)?;
+        std::str::from_utf8(buffer.get(start..position)?).ok()?;
+        remaining -= length;
+    }
+    Some(position)
+}
