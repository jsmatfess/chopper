+use super::*;
+use crate::{resources::MemoryPool, storage::Workspace};
+use std::{
+    io::Write,
+    path::{Path, PathBuf},
+    sync::{atomic::Ordering::Relaxed, Mutex},
+};
+
+const MEMORY: u64 = 32 * 1024 * 1024;
+const ROWS: usize = 70_003;
+const PARENTS: usize = 8;
+const SEED: &str = "exact-resident-bucket-v1";
+const BYTE_LIMIT: u64 = 65_536;
+
+fn make_fixture(dir: &Path) -> Result<(PathBuf, String)> {
+    let input = dir.join("input.csv");
+    let mut source = std::io::BufWriter::new(std::fs::File::create(&input)?);
+    writeln!(source, "id,region,payload")?;
+    let payload = "x".repeat(128);
+    for id in 0..ROWS {
+        writeln!(source, "{id},{},{payload}", id % PARENTS)?;
+    }
+    source.flush()?;
+    Ok((input, payload))
+}
+
+fn job(input: &Path, output: &Path, temp: &Path, arm: &str) -> Job {
+    Job {
+        input: input.to_string_lossy().into(),
+        output: output.to_string_lossy().into(),
+        random_seed: Some(SEED.into()),
+        operations: vec![
+            Operation::Partition {
+                columns: vec![Column::Name("region".into())],
+            },
+            Operation::Assign {
+                groups: (0..=8)
+                    .map(|n| Allocation {
+                        name: format!("a{n}"),
+                        percent: if n < 8 { "12.5".into() } else { "0".into() },
+                    })
+                    .collect(),
+                strata: vec![],
+            },
+        ],
+        limits: chopper_core::Limits {
+            rows: Some(600),
+            bytes: Some(BYTE_LIMIT),
+            ..Default::default()
+        },
+        resources: Resources {
+            memory_mb: 32.into(),
+            workers: 1,
+            grouping: if arm == "sort" {
+                Grouping::Sort
+            } else {
+                Grouping::Auto
+            },
+            max_record_bytes: 16 * 1024,
+            temp_dir: Some(temp.to_string_lossy().into()),
+            ..Default::default()
+        },
+        ..Default::default()
+    }
+}
+
+fn execute(
+    job: Job,
+    cancel: Arc<AtomicBool>,
+    notify: Notify,
+    pool: Arc<MemoryPool>,
+) -> Result<(Analysis, serde_json::Value)> {
+    let mut input_reads = 0;
+    let result = process_using(
+        job,
+        cancel,
+        notify,
+        pool,
+        None,
+        false,
+        |job, ctx, p, b, s| {
+            input_reads += 1;
+            with_input(job, Reservation::new(ctx), |mut source| {
+                ingest_options(source.as_mut(), job, ctx, p, b, s)
+            })
+        },
+    );
+    assert_eq!(input_reads, 1);
+    let result = result?;
+    let Processed::Snapshot(ref prepared) = result else {
+        panic!("expected standard encoded snapshot path");
+    };
+    let ctx = prepared.ctx.clone();
+    let analysis = result.publish()?.into_analysis();
+    let counters = ctx.diagnostics();
+    Ok((analysis, counters))
+}
+
+#[derive(Clone, Copy, Debug)]
+enum Pressure {
+    None,
+    ReaderRetry(bool),
+    FixedSelection(usize),
+    FixedEmission(usize),
+}
+
+#[test]
+fn resident_exact_buckets_preserve_output_and_admission_boundary() -> Result<()> {
+    let dir = tempfile::tempdir()?;
+    let (input, payload) = make_fixture(dir.path())?;
+    let out = dir.path().join("out");
+    let temp = dir.path().join("temp");
+    std::fs::create_dir(&temp)?;
+    let mut reference = None;
+    for pressure in [
+        Pressure::None,
+        Pressure::FixedSelection(28),
+        Pressure::FixedSelection(30),
+        Pressure::FixedEmission(30),
+        Pressure::ReaderRetry(false),
+        Pressure::ReaderRetry(true),
+    ] {
+        let arms = if matches!(pressure, Pressure::ReaderRetry(_)) {
+            &["bucket"][..]
+        } else {
+            &["auto", "sort", "bucket"][..]
+        };
+        for &arm in arms {
+            DISABLE_BUCKETS.with(|flag| flag.set(arm != "bucket"));
+            let pool = Arc::new(MemoryPool::new(MEMORY));
+            let owner = Arc::new(Mutex::new(Reservation::for_workspace(Arc::new(
+                Workspace::shared(MEMORY as usize, pool.clone()),
+            ))));
+            let counters = Arc::new([0, 1, 2, 3].map(|_| std::sync::atomic::AtomicUsize::new(0)));
+            let cancel = Arc::new(AtomicBool::new(false));
+            let notify: Notify = {
+                let (owner, pool, counters, cancel) = (
+                    owner.clone(),
+                    pool.clone(),
+                    counters.clone(),
+                    cancel.clone(),
+                );
+                Arc::new(move |progress| {
+                    if progress.phase == "Retrying exact assignment after resident denial" {
+                        counters[1].fetch_add(1, Relaxed);
+                        if matches!(pressure, Pressure::ReaderRetry(_)) {
+                            owner.lock().unwrap().resize(0).unwrap();
+                        }
+                    }
+                    if progress.phase == "Emitting resident exact assignment" {
+                        counters[2].fetch_add(1, Relaxed);
+                    }
+                    let target = match pressure {
+                        Pressure::FixedSelection(mib)
+                            if progress.phase == "Preparing operation 2 of 2" =>
+                        {
+                            Some(mib * 1024 * 1024)
+                        }
+                        Pressure::FixedEmission(mib) if progress.phase == "Serializing output" => {
+                            Some(mib * 1024 * 1024)
+                        }
+                        Pressure::ReaderRetry(_)
+                            if progress.phase == "Before reserved exact parent read" =>
+                        {
+                            Some((MEMORY - pool.usage().reserved_bytes - 32_767) as usize)
+                        }
+                        _ => None,
+                    };
+                    if let Some(target) = target {
+                        if counters[0].fetch_add(1, Relaxed) == 0 {
+                            match owner.lock().unwrap().resize(target) {
+                                Ok(()) => counters[3].fetch_add(1, Relaxed),
+                                Err(error) => {
+                                    assert!(matches!(
+                                        pressure,
+                                        Pressure::FixedSelection(_) | Pressure::FixedEmission(_)
+                                    ));
+                                    assert!(error.downcast_ref::<MemoryAdmission>().is_some());
+                                    println!("exact-peer-denied pressure={pressure:?} arm={arm} request={target}");
+                                    0
+                                }
+                            };
+                            if matches!(pressure, Pressure::ReaderRetry(true)) {
+                                cancel.store(true, Relaxed);
+                            }
+                        }
+                    }
+                })
+            };
+            let result = execute(job(&input, &out, &temp, arm), cancel, notify, pool.clone());
+            let retried = counters[1].load(Relaxed);
+            let emitted = counters[2].load(Relaxed);
+            let state = match result {
+                Ok((analysis, diagnostics)) => {
+                    let snapshot = verify(&out, analysis, &payload)?;
+                    if let Some(expected) = &reference {
+                        assert_eq!(&snapshot, expected);
+                    } else {
+                        reference = Some(snapshot);
+                    }
+                    std::fs::remove_dir_all(&out)?;
+                    if matches!(pressure, Pressure::None) {
+                        assert_eq!(retried, 0);
+                        assert_eq!(emitted, if arm == "bucket" { PARENTS } else { 0 });
+                    }
+                    if matches!(pressure, Pressure::ReaderRetry(false)) {
+                        assert_eq!(retried, 1);
+                        assert_eq!(emitted, PARENTS - 1);
+                    }
+                    println!("stats {pressure:?} {arm} {diagnostics}");
+                    "complete"
+                }
+                Err(error) => {
+                    if matches!(pressure, Pressure::ReaderRetry(true)) {
+                        assert!(format!("{error:#}").contains("job cancelled"), "{error:#}");
+                        assert_eq!(retried, 0);
+                        assert_eq!(emitted, 0);
+                        "cancelled"
+                    } else {
+                        assert!(matches!(
+                            pressure,
+                            Pressure::FixedSelection(_) | Pressure::FixedEmission(_)
+                        ));
+                        assert!(
+                            error.downcast_ref::<MemoryAdmission>().is_some(),
+                            "{error:#}"
+                        );
+                        "denied"
+                    }
+                }
+            };
+            let mut owner = owner.lock().unwrap();
+            match pressure {
+                Pressure::FixedSelection(mib) | Pressure::FixedEmission(mib) => {
+                    assert_eq!(counters[0].load(Relaxed), 1);
+                    let grant = counters[3].load(Relaxed) * mib * 1024 * 1024;
+                    assert_eq!(owner.bytes(), grant as u64);
+                }
+                _ => {}
+            }
+            println!("exact-frontier pressure={pressure:?} arm={arm} state={state} peer={} retries={retried} buckets={emitted}", owner.bytes());
+            assert_eq!(std::fs::read_dir(&temp)?.count(), 0);
+            assert!(!out.exists());
+            assert_eq!(std::fs::read_dir(dir.path())?.count(), 2);
+            assert_eq!(pool.usage().reserved_bytes, owner.bytes());
+            owner.resize(0)?;
+            assert_eq!(pool.usage().reserved_bytes, 0);
+        }
+    }
+    Ok(())
+}
+
+fn verify(
+    out: &Path,
+    analysis: Analysis,
+    payload: &str,
+) -> Result<(serde_json::Value, Vec<String>)> {
+    let mut logical = serde_json::to_value(analysis)?;
+    for key in [
+        "temp_bytes",
+        "peak_temp_bytes",
+        "analysis_seconds",
+        "timings",
+        "diagnostics",
+    ] {
+        logical.as_object_mut().unwrap().remove(key);
+    }
+    assert_eq!(logical["rows"].as_u64(), Some(ROWS as u64));
+    assert_eq!(logical["groups"].as_u64(), Some((PARENTS * 9) as u64));
+    let mut expected = vec![0; ROWS];
+    let mut quota_counts = [[0u64; 9]; PARENTS];
+    for parent in 0..PARENTS {
+        let ancestry = [serde_json::json!({"values":[parent.to_string()],"operation":0})];
+        let mut rng = Random::new(random::json_domain(SEED, 1, &ancestry)?);
+        let count = (parent..ROWS).step_by(PARENTS).len() as u64;
+        let mut quotas = [0; 9];
+        for (n, quota) in quotas[..8].iter_mut().enumerate() {
+            *quota = count / 8 + u64::from((n as u64) < count % 8);
+        }
+        quota_counts[parent] = quotas;
+        let mut remaining = count;
+        for id in (parent..ROWS).step_by(PARENTS) {
+            let mut choice = rng.below(remaining);
+            remaining -= 1;
+            for (index, quota) in quotas.iter_mut().enumerate() {
+                if choice < *quota {
+                    *quota -= 1;
+                    expected[id] = index;
+                    break;
+                }
+                choice -= *quota;
+            }
+        }
+    }
+    let manifest = std::fs::read_to_string(out.join("manifest.jsonl"))?;
+    let mut seen = vec![false; ROWS];
+    let mut order = [[None; 9]; PARENTS];
+    let mut found = [[0u64; 9]; PARENTS];
+    let mut empty = [false; PARENTS];
+    let mut hashes = Vec::new();
+    for line in manifest.lines().skip(1) {
+        let record: serde_json::Value = serde_json::from_str(line)?;
+        let lineage = record["lineage"].as_array().context("missing lineage")?;
+        assert_eq!(lineage.len(), 2);
+        assert_eq!(lineage[0]["operation"].as_u64(), Some(0));
+        assert_eq!(lineage[1]["operation"].as_u64(), Some(1));
+        let parent: usize = lineage[0]["values"][0]
+            .as_str()
+            .context("missing partition")?
+            .parse()?;
+        let group: usize = lineage[1]["allocation"]
+            .as_str()
+            .context("missing assignment")?[1..]
+            .parse()?;
+        let path = record["path"].as_str().context("missing output path")?;
+        let csv = std::fs::read(out.join(path))?;
+        assert_eq!(record["csv_bytes"].as_u64(), Some(csv.len() as u64));
+        assert!(csv.len() as u64 <= BYTE_LIMIT);
+        let mut rows = std::str::from_utf8(&csv)?.lines();
+        assert_eq!(rows.next(), Some("id,region,payload"));
+        let mut count = 0;
+        for row in rows {
+            let fields: Vec<_> = row.split(',').collect();
+            assert_eq!(fields.len(), 3);
+            let id: usize = fields[0].parse()?;
+            assert!(!std::mem::replace(&mut seen[id], true));
+            assert_eq!(fields[1].parse::<usize>()?, parent);
+            assert_eq!(id % PARENTS, parent);
+            assert_eq!(fields[2], payload);
+            assert_eq!(group, expected[id]);
+            if let Some(previous) = order[parent][group].replace(id) {
+                assert!(previous < id);
+            }
+            count += 1;
+        }
+        assert_eq!(record["rows"].as_u64(), Some(count));
+        assert!(count <= 600);
+        if group == 8 {
+            assert_eq!(count, 0);
+            assert!(!std::mem::replace(&mut empty[parent], true));
+        }
+        found[parent][group] += count;
+        hashes.push(format!("{line} {}", blake3::hash(&csv)));
+    }
+    assert_eq!(found, quota_counts);
+    assert!(empty.into_iter().all(|found| found));
+    assert!(seen.into_iter().all(|found| found));
+    assert_eq!(std::fs::read_dir(out)?.count(), hashes.len() + 1);
+    Ok((logical, hashes))
+}
