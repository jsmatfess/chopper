+//! Exact retained-parent assignment without a comparison sort when its buckets fit.
+use super::*;
+use crate::{
+    observation::{
+        physical::{self, Kind},
+        Status,
+    },
+    resources::MemoryAdmission,
+    storage::ResidentBuckets,
+};
+
+struct Child {
+    lineage: Vec<serde_json::Value>,
+    _lineage_memory: Reservation,
+}
+
+pub(super) struct Prepared {
+    buckets: ResidentBuckets,
+    children: Vec<Child>,
+    _child_vector: Reservation,
+}
+
+#[cfg(test)]
+std::thread_local! {
+    static DISABLE_BUCKETS: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+#[cfg(test)]
+mod tests;
+
+pub(super) fn eligible(job: &Job, step: usize) -> bool {
+    #[cfg(test)]
+    if DISABLE_BUCKETS.with(std::cell::Cell::get) {
+        return false;
+    }
+    step == 1
+        && job.resources.grouping == chopper_core::Grouping::Auto
+        && job.compression == chopper_core::Compression::None
+        && matches!(
+            job.operations.as_slice(),
+            [Operation::Partition { .. }, Operation::Assign { strata, .. }]
+            if strata.is_empty()
+        )
+}
+
+pub(super) fn prepare(
+    data: &Dataset,
+    parent: &Group,
+    groups: &[Allocation],
+    step: usize,
+    domain: &[u8; 32],
+    ctx: &Context,
+) -> Result<Prepared> {
+    let mut scratch = AssignmentScratch::new(groups, false, Reservation::new(ctx))?;
+    scratch.reset_quota(parent.rows);
+    let mut buckets = ResidentBuckets::new(&scratch.quota, ctx)?;
+    let mut child_vector = Reservation::new(ctx);
+    let mut children = Vec::new();
+    child_vector.reserve_vec(&mut children, groups.len())?;
+    for allocation in groups {
+        let entry = child_metadata::Entry::allocation(step, &allocation.name);
+        let (lineage, memory) = child_metadata::build(parent, &entry, ctx, Reservation::new(ctx))?;
+        children.push(Child {
+            lineage,
+            _lineage_memory: memory,
+        });
+    }
+
+    let mut observation = ctx.physical_attempt(Kind::ExactMembership);
+    let mut observed = physical::AllocationCounts {
+        len: groups.len(),
+        ..Default::default()
+    };
+    let result = (|| -> Result<()> {
+        #[cfg(test)]
+        ctx.event("Before reserved exact parent read", parent.rows)?;
+        let mut remaining = parent.rows;
+        let mut rng = Random::new(*domain);
+        for row in data.packed_rows(parent, ctx.max_record)? {
+            ctx.check()?;
+            let row = row?;
+            let index = assignment::take_linear(&mut scratch.quota, rng.below(remaining));
+            remaining -= 1;
+            scratch.counts[index] += 1;
+            buckets.push(index, row)?;
+            observed.rows += 1;
+            if let Some(attempt) = &mut observation {
+                attempt.rows_processed(observed.rows);
+            }
+        }
+        ensure!(remaining == 0, "truncated resident assignment parent");
+        observed.groups = groups.len() as u64;
+        observed.empty_groups = scratch.counts.iter().filter(|&&count| count == 0).count() as u64;
+        Ok(())
+    })();
+    if let Some(attempt) = observation {
+        for (slot, count) in observed.memberships.iter_mut().zip(scratch.counts) {
+            *slot = count;
+        }
+        attempt.allocation(
+            result
+                .as_ref()
+                .err()
+                .map_or(Status::Completed, physical::error_status),
+            observed,
+        );
+    }
+    result?;
+    Ok(Prepared {
+        buckets,
+        children,
+        _child_vector: child_vector,
+    })
+}
+
+impl Prepared {
+    pub(super) fn emit(mut self, output: &mut impl RowSink, ctx: &Context) -> Result<()> {
+        #[cfg(test)]
+        ctx.event("Emitting resident exact assignment", 0)?;
+        output.physical_input(ctx.physical_identity(Kind::ExactMembership));
+        for (index, child) in self.children.drain(..).enumerate() {
+            ctx.check()?;
+            let Child {
+                lineage,
+                _lineage_memory,
+            } = child;
+            let mut group = output.begin(lineage, false);
+            for row in self.buckets.take(index).compact() {
+                ctx.check()?;
+                output.packed_row_ref(&mut group, &row?)?;
+            }
+            ctx.check()?;
+            output.end(group)?;
+        }
+        Ok(())
+    }
+}
+
+pub(super) fn retryable(error: &anyhow::Error) -> bool {
+    error.downcast_ref::<MemoryAdmission>().is_some()
+}
