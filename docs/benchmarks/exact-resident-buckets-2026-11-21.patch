+/// Bounded stable buckets for an exact resident assignment. Packed rows transfer
+/// their existing decode leases into the bucket owner without copying payloads.
+#[cfg(all(target_os = "linux", feature = "experimental-resident-exact-buckets"))]
+pub(crate) struct ResidentBuckets {
+    buckets: Vec<ResidentBucket>,
+    memory: Reservation,
+    limit: usize,
+}
+#[cfg(all(target_os = "linux", feature = "experimental-resident-exact-buckets"))]
+#[derive(Default)]
+struct ResidentBucket {
+    rows: Vec<PackedRow>,
+    payload_bytes: usize,
+}
+#[cfg(all(target_os = "linux", feature = "experimental-resident-exact-buckets"))]
+impl ResidentBuckets {
+    pub(crate) fn new(quotas: &[u64], ctx: &Context) -> Result<Self> {
+        use crate::resources::MemoryAdmission;
+        let limit = ctx.workspace.sort_buffer_limit(ctx.memory / 4);
+        let descriptor_bytes = quotas.iter().try_fold(0usize, |bytes, &quota| {
+            usize::try_from(quota)
+                .ok()
+                .and_then(|rows| rows.checked_mul(std::mem::size_of::<PackedRow>()))
+                .and_then(|needed| bytes.checked_add(needed))
+                .ok_or(MemoryAdmission::Local)
+        })?;
+        let catalog_bytes = quotas
+            .len()
+            .saturating_mul(std::mem::size_of::<ResidentBucket>());
+        if descriptor_bytes.saturating_add(catalog_bytes) > limit {
+            return Err(MemoryAdmission::Local.into());
+        }
+        let mut memory = Reservation::new(ctx);
+        let mut buckets = Vec::new();
+        memory.reserve_vec(&mut buckets, quotas.len())?;
+        for &quota in quotas {
+            buckets.push(ResidentBucket::default());
+            memory.reserve_vec(
+                &mut buckets.last_mut().unwrap().rows,
+                usize::try_from(quota).map_err(|_| MemoryAdmission::Local)?,
+            )?;
+        }
+        if memory.bytes() > limit as u64 {
+            return Err(MemoryAdmission::Local.into());
+        }
+        Ok(Self {
+            buckets,
+            memory,
+            limit,
+        })
+    }
+
+    pub(crate) fn push(&mut self, index: usize, mut row: PackedRow) -> Result<()> {
+        let bucket = &mut self.buckets[index];
+        ensure!(
+            bucket.rows.len() < bucket.rows.capacity(),
+            "exact resident bucket exceeded its descriptor reservation"
+        );
+        row.key = PackedKey::Bytes(Box::default());
+        let bytes = row.heap_bytes();
+        if self.memory.bytes().saturating_add(bytes as u64) > self.limit as u64 {
+            return Err(crate::resources::MemoryAdmission::Local.into());
+        }
+        let owner = row
+            .decode_reservation
+            .as_mut()
+            .context("packed source row is missing its decode lease")?;
+        owner.resize(bytes)?;
+        self.memory.absorb(row.decode_reservation.take().unwrap());
+        bucket.payload_bytes += bytes;
+        bucket.rows.push(row);
+        Ok(())
+    }
+
+    pub(crate) fn take(&mut self, index: usize) -> ResidentRows {
+        let bucket = std::mem::take(&mut self.buckets[index]);
+        let descriptor_bytes = bucket.rows.capacity() * std::mem::size_of::<PackedRow>();
+        let reservation = self.memory.split(descriptor_bytes + bucket.payload_bytes);
+        ResidentRows {
+            rows: bucket.rows.into_iter(),
+            _reservation: reservation,
+        }
     }
 }
 
