+#[test]
+fn resident_exact_sink_denial_never_retries() -> Result<()> {
+    struct RejectSecond(usize);
+    impl RowSink for RejectSecond {
+        fn begin(&self, lineage: Vec<serde_json::Value>, exact: bool) -> Group {
+            Group {
+                offset: 0,
+                rows: 0,
+                lineage,
+                exact,
+            }
+        }
+        fn row(&mut self, group: &mut Group, _: &Row) -> Result<()> {
+            self.0 += 1;
+            if self.0 == 2 {
+                return Err(MemoryAdmission::Local.into());
+            }
+            group.rows += 1;
+            Ok(())
+        }
+        fn end(&mut self, _: Group) -> Result<()> {
+            Ok(())
+        }
+    }
+    let dir = tempfile::tempdir()?;
+    let temp = dir.path().join("temp");
+    std::fs::create_dir(&temp)?;
+    let job = job(
+        &dir.path().join("input"),
+        &dir.path().join("output"),
+        &temp,
+        "bucket",
+    );
+    let pool = Arc::new(MemoryPool::new(MEMORY));
+    let retries = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+    let notify = {
+        let retries = retries.clone();
+        Arc::new(move |event: crate::storage::Progress| {
+            if event.phase == "Retrying exact assignment after resident denial" {
+                retries.fetch_add(1, Relaxed);
+            }
+        })
+    };
+    let ctx = Context::with_memory_pool(
+        &job.resources,
+        Arc::new(AtomicBool::new(false)),
+        notify,
+        pool.clone(),
+    )?;
+    let mut text = String::from("id,region,payload\n");
+    use std::fmt::Write as _;
+    for id in 0..128 {
+        writeln!(text, "{id},0,value")?;
+    }
+    let source = ingest(Box::new(text.as_bytes()), &job, &ctx)?;
+    let parent = source.dataset.groups()?.next().unwrap()?;
+    let mut sink = RejectSecond(0);
+    let error = apply_parent(
+        &source.dataset,
+        &parent,
+        &job.operations[1],
+        1,
+        &job,
+        &source.analysis,
+        &ctx,
+        &mut sink,
+        None,
+        None,
+    )
+    .expect_err("terminal sink deny");
+    assert!(matches!(
+        error.downcast_ref::<MemoryAdmission>(),
+        Some(MemoryAdmission::Local)
+    ));
+    assert_eq!(sink.0, 2);
+    assert_eq!(retries.load(Relaxed), 0);
+    drop(parent);
+    drop(source);
+    drop(ctx);
+    assert_eq!(pool.usage().reserved_bytes, 0);
+    assert_eq!(std::fs::read_dir(&temp)?.count(), 0);
+    Ok(())
+}
