+#[test]
+#[ignore = "requires a pinned full-job fixture"]
+fn measure_resident_exact_buckets() -> Result<()> {
+    let config = std::env::var_os("CHOPPER_EXACT_RESIDENT_CONFIG").context("missing pinned job")?;
+    let arm = std::env::var("CHOPPER_EXACT_RESIDENT_ARM")?;
+    ensure!(
+        matches!(arm.as_str(), "auto" | "sort" | "bucket"),
+        "unknown arm"
+    );
+    DISABLE_BUCKETS.with(|flag| flag.set(arm != "bucket"));
+    let mut job: Job = serde_json::from_slice(&std::fs::read(config)?)?;
+    job.random_seed = Some(SEED.into());
+    assert_eq!(
+        job.resources.grouping,
+        if arm == "sort" {
+            Grouping::Sort
+        } else {
+            Grouping::Auto
+        }
+    );
+    let pool = Arc::new(MemoryPool::new(
+        std::env::var("CHOPPER_EXACT_RESIDENT_SHARED_BYTES")?.parse()?,
+    ));
+    let counters = Arc::new([0, 1].map(|_| std::sync::atomic::AtomicUsize::new(0)));
+    let notify = {
+        let counters = counters.clone();
+        Arc::new(move |p: crate::storage::Progress| {
+            if p.phase == "Retrying exact assignment after resident denial" {
+                counters[0].fetch_add(1, Relaxed);
+            } else if p.phase == "Emitting resident exact assignment" {
+                counters[1].fetch_add(1, Relaxed);
+            }
+        })
+    };
+    let now = std::time::Instant::now();
+    let (analysis, diagnostics) =
+        execute(job, Arc::new(AtomicBool::new(false)), notify, pool.clone())?;
+    let elapsed = now.elapsed().as_secs_f64();
+    println!(
+        "MEASUREMENT {}",
+        serde_json::json!({"arm": arm, "elapsed_seconds": elapsed, "rows": analysis.rows,
+            "files": analysis.output_files, "output_csv_bytes": analysis.output_csv_bytes,
+            "retries": counters[0].load(Relaxed), "buckets": counters[1].load(Relaxed),
+            "diagnostics": diagnostics, "peak_reserved_bytes": pool.usage().peak_reserved_bytes})
+    );
+    drop(analysis);
+    assert_eq!(pool.usage().reserved_bytes, 0);
+    Ok(())
+}
