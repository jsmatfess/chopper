+    #[test]
+    fn parent_retry_admission_parity_and_cleanup() -> Result<()> {
+        let mut observed_retry = false;
+        for (count, payload, available) in [
+            (64, 128, 300_000),
+            (2500, 128, 300_000),
+            (1, 200_000, 500_000),
+        ] {
+            let mut reference = None;
+            for resident in [false, true] {
+                let mut ctx = context()?;
+                ctx.memory = 4 * 1024 * 1024;
+                ctx.replace_workspace_for_test(Workspace::new(2 * 1024 * 1024))?;
+                let mut input = DatasetWriter::new(&ctx)?;
+                let mut group = input.begin(vec![], false);
+                for id in 0..count {
+                    input.row(
+                        &mut group,
+                        &Row {
+                            id,
+                            ordinal: id,
+                            key: vec![],
+                            fields: vec![id.to_string(), "x".repeat(payload), (id % 7).to_string()],
+                        },
+                    )?;
+                }
+                input.end(group)?;
+                let data = input.finish()?;
+                let before = ctx.diagnostics()["workspace_reserved_bytes"]
+                    .as_u64()
+                    .unwrap();
+                let mut other = Reservation::new(&ctx);
+                other.resize(
+                    (2 * 1024 * 1024 - available - before + ctx.directory_reserved_bytes())
+                        as usize,
+                )?;
+                let held = ctx.diagnostics()["workspace_reserved_bytes"]
+                    .as_u64()
+                    .unwrap();
+                let parent = data.groups()?.next().unwrap()?;
+                let operation = probabilistic();
+                let ready =
+                    prepare_parent(&data, &parent, &operation, None, 3, [7; 32], &ctx, resident)?;
+                observed_retry |= ready.retried;
+                eprintln!(
+                    "PARENT_RETRY count={count} payload={payload} resident={resident} retried={}",
+                    ready.retried
+                );
+                let mut output = DatasetWriter::new(&ctx)?;
+                ready.emit(&parent, 0, &mut output, &ctx)?;
+                let output = output.finish()?;
+                let mut actual = Vec::new();
+                for group in output.groups()? {
+                    let group = group?;
+                    actual.extend_from_slice(serde_json::to_string(&group)?.as_bytes());
+                    for row in output.rows(&group, ctx.max_record)? {
+                        let row = row?;
+                        write_row(&mut actual, &row)?;
+                    }
+                }
+                if let Some(reference) = &reference {
+                    assert_eq!(&actual, reference);
+                } else {
+                    reference = Some(actual);
+                }
+                drop(output);
+                assert_eq!(ctx.diagnostics()["workspace_reserved_bytes"], held);
+                drop(other);
+                drop(data);
+                assert_eq!(ctx.used(), 0);
+                assert_eq!(
+                    ctx.diagnostics()["workspace_reserved_bytes"],
+                    ctx.directory_reserved_bytes()
+                );
+            }
+        }
+        assert!(observed_retry, "control must reach admission retry");
+        Ok(())
+    }
