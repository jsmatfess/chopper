+std::thread_local! {
+    static PARENT_SCANS: std::cell::Cell<usize> = const { std::cell::Cell::new(0) };
+}
+
+/// Experiment only: retry admitted materialized input before any sink emission.
+#[allow(clippy::too_many_arguments)]
+pub(super) fn prepare_parent<'a>(
+    data: &Dataset,
+    parent: &Group,
+    operation: &'a Operation,
+    header: Option<&[String]>,
+    width: usize,
+    domain: [u8; 32],
+    ctx: &Context,
+    try_resident: bool,
+) -> Result<ReadyGroups<'a>> {
+    let scan = |resident| -> Result<ReadyGroups<'a>> {
+        #[cfg(test)]
+        PARENT_SCANS.with(|count| count.set(count.get() + 1));
+        let mut state = StreamingGroups {
+            sorter: if resident {
+                Sorter::new(ctx, SortOrder::Key)
+            } else {
+                Sorter::streaming(ctx)
+            },
+            membership: Membership::new(operation, header, width, domain, ctx)?,
+        };
+        let mut rows = data.rows(parent, ctx.max_record)?;
+        let mut previous = None;
+        while let Some(row) = rows.next_packed(previous.take())? {
+            previous = state.push_compact(row)?;
+        }
+        state.finish()
+    };
+    if try_resident {
+        match scan(true) {
+            Ok(ready) => return Ok(ready),
+            Err(error)
+                if error
+                    .downcast_ref::<crate::resources::MemoryAdmission>()
+                    .is_some() =>
+            {
+                // The failed scan and its readers/rows/files are destroyed here.
+                // Cancellation and cleanup failures prohibit retry.
+                ctx.check()?;
+            }
+            Err(error) => return Err(error),
+        }
+    }
+    let ready = scan(false)?;
+    #[cfg(test)]
+    let ready = ReadyGroups {
+        retried: try_resident,
+        ..ready
+    };
+    Ok(ready)
+}
