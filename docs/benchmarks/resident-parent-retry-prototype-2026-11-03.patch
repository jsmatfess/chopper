+    #[test]
+    fn parent_retry_terminal_errors_and_emission_boundary() -> Result<()> {
+        struct DeniedSink {
+            rows: usize,
+        }
+        impl RowSink for DeniedSink {
+            fn begin(&self, lineage: Vec<serde_json::Value>, exact: bool) -> Group {
+                Group {
+                    offset: 0,
+                    rows: 0,
+                    lineage,
+                    exact,
+                }
+            }
+            fn row(&mut self, _group: &mut Group, _row: &Row) -> Result<()> {
+                self.rows += 1;
+                Err(crate::resources::MemoryAdmission::Local.into())
+            }
+            fn end(&mut self, _group: Group) -> Result<()> {
+                Ok(())
+            }
+        }
+        for failure in ["cancel", "malformed", "emission"] {
+            let flag = Arc::new(AtomicBool::new(false));
+            let mut ctx = Context::new(
+                &Resources {
+                    workers: 1,
+                    ..Default::default()
+                },
+                flag.clone(),
+                Arc::new(|_| {}),
+            )?;
+            let mut input = DatasetWriter::new(&ctx)?;
+            let mut group = input.begin(vec![], false);
+            for id in 0..64 {
+                input.row(
+                    &mut group,
+                    &Row {
+                        id,
+                        ordinal: id,
+                        key: vec![],
+                        fields: vec![id.to_string(), "x".repeat(128), (id % 7).to_string()],
+                    },
+                )?;
+            }
+            input.end(group)?;
+            let data = input.finish()?;
+            let parent = data.groups()?.next().unwrap()?;
+            let held = ctx.diagnostics()["workspace_reserved_bytes"]
+                .as_u64()
+                .unwrap();
+            if failure == "cancel" {
+                flag.store(true, std::sync::atomic::Ordering::Relaxed);
+            }
+            if failure == "malformed" {
+                ctx.max_record = 1;
+            }
+            let operation = probabilistic();
+            PARENT_SCANS.with(|count| count.set(0));
+            let ready = prepare_parent(&data, &parent, &operation, None, 3, [7; 32], &ctx, true);
+            if failure == "emission" {
+                let mut sink = DeniedSink { rows: 0 };
+                let error = ready?
+                    .emit(&parent, 0, &mut sink, &ctx)
+                    .expect_err("sink must deny");
+                assert!(error
+                    .downcast_ref::<crate::resources::MemoryAdmission>()
+                    .is_some());
+                assert_eq!(sink.rows, 1);
+            } else {
+                let error = ready.err().expect("input must fail");
+                assert!(error
+                    .downcast_ref::<crate::resources::MemoryAdmission>()
+                    .is_none());
+            }
+            assert_eq!(
+                PARENT_SCANS.with(|count| count.get()),
+                1,
+                "{failure} must not replay"
+            );
+            assert_eq!(ctx.diagnostics()["workspace_reserved_bytes"], held);
+            drop(parent);
+            drop(data);
+            assert_eq!(ctx.used(), 0);
+            assert_eq!(
+                ctx.diagnostics()["workspace_reserved_bytes"],
+                ctx.directory_reserved_bytes()
+            );
+            eprintln!("PARENT_TERMINAL {failure} scans=1 cleanup=true");
+        }
+        Ok(())
+    }
