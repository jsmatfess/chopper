+#[cfg(any(test, all(target_os = "wasi", feature = "resource-contract-tests")))]
+pub(crate) fn hosted_mixed_merge_pressure() -> Result<serde_json::Value> {
+    use crate::{output::PlanWriter, resources::MemoryPool};
+
+    const MIB: usize = 1024 * 1024;
+    const SHARED: usize = 128 * MIB;
+    let mut late_peer = None;
+    let mut reports = Vec::new();
+    for (candidate, pressure) in [
+        (true, "late"),
+        (false, "late"),
+        (true, "early"),
+        (false, "early"),
+        (true, "none"),
+        (false, "none"),
+        (true, "cancel"),
+    ] {
+        let pool = Arc::new(MemoryPool::new(SHARED as u64));
+        let cancel = Arc::new(AtomicBool::new(false));
+        let ctx = Context::with_memory_pool(
+            &chopper_core::Resources {
+                memory_mb: 128.into(),
+                workers: 1,
+                temp_dir: cfg!(target_os = "wasi").then(|| "/tmp".into()),
+                ..Default::default()
+            },
+            cancel.clone(),
+            Arc::new(|_| {}),
+            pool.clone(),
+        )?;
+        let mut sorter = Sorter::new(&ctx, SortOrder::Random([19; 32]));
+        let row = |id| Row {
+            id,
+            ordinal: id,
+            key: u128::from(id).to_be_bytes().to_vec(),
+            fields: vec!["x".repeat(MIB / 2)],
+        };
+        sorter.push(row(0))?;
+        sorter.flush_run(false, None)?;
+        for id in (1..13).rev() {
+            sorter.push(row(id))?;
+        }
+        let mut peer =
+            Reservation::for_workspace(Arc::new(Workspace::shared(SHARED, pool.clone())));
+        if pressure == "early" {
+            peer.resize(SHARED - pool.usage().reserved_bytes as usize - 2 * MIB)?;
+        }
+        let sorted = sorter.finish_with_tail(candidate)?;
+        let SortedRows::Merge(merge) = &sorted else {
+            anyhow::bail!("expected merge traversal");
+        };
+        let mixed = merge.tail.is_some();
+        ensure!(mixed == (candidate && pressure != "early"));
+        let pre_writer = pool.usage().reserved_bytes;
+        let mut job = chopper_core::Job::default();
+        job.limits.bytes = Some((2 * MIB) as u64);
+        let mut writer = PlanWriter::new(&job, None, &ctx)?;
+        let pre_peer = pool.usage().reserved_bytes;
+        if pressure == "late" {
+            let matched_peer =
+                *late_peer.get_or_insert_with(|| SHARED - pre_peer as usize - 64 * 1024);
+            peer.resize(matched_peer)?;
+        }
+        let headroom = ctx.working_headroom();
+        if pressure == "cancel" {
+            cancel.store(true, AtomicOrdering::Relaxed);
+        }
+        let mut group = writer.begin(vec![], false);
+        let mut count = 0;
+        let traversal = sorted.try_for_each_packed(|row| {
+            ensure!(row.id == count);
+            ensure!(row.fields().next().unwrap().len() == MIB / 2);
+            writer.packed_row_ref(&mut group, row)?;
+            count += 1;
+            Ok(())
+        });
+        let delivered = traversal.is_ok();
+        let error = traversal.as_ref().err().map(|e| format!("{e:#}"));
+        if pressure == "late" && candidate {
+            ensure!(traversal
+                .unwrap_err()
+                .downcast_ref::<crate::resources::MemoryAdmission>()
+                .is_some_and(|x| matches!(x, crate::resources::MemoryAdmission::Shared { .. })));
+        } else if pressure == "cancel" {
+            ensure!(error.as_ref().is_some_and(|e| e.contains("cancel")));
+        } else {
+            traversal?;
+            ensure!(count == 13);
+            writer.end(group)?;
+        }
+        drop(writer);
+        ensure!(ctx.used() == 0);
+        drop(ctx);
+        ensure!(pool.usage().reserved_bytes == peer.bytes());
+        reports.push(serde_json::json!({
+            "candidate":candidate,"pressure":pressure,"mixed":mixed,
+            "shared_pool_bytes":SHARED,"peer_bytes":peer.bytes(),
+            "before_writer_reserved_bytes":pre_writer,"before_late_peer_reserved_bytes":pre_peer,
+            "available_before_rows_bytes":headroom,"rows_to_encoder":count,
+            "all_rows_encoded":delivered,"failure":error,"cleanup":true,
+        }));
+        drop(peer);
+        ensure!(pool.usage().reserved_bytes == 0);
+    }
+    Ok(serde_json::json!(reports))
+}
