+  for(let retry=0;retry<50;retry++) {
+    try {
+      const {stdout} = await displayCommand(options.xdotool,['search','--onlyvisible','--name',label]);
+      windowId=stdout.trim().split('\n').at(-1);
+      if(windowId) break;
+    } catch(error) {
+      if(error.code!=='ENOENT' && error.code!==1) throw error;
+      await delay(100);
+    }
+  }
+  if(!windowId) {
+    const {stdout}=await displayCommand('/usr/bin/xwininfo',['-root','-tree']);
+    console.error(stdout, await page.evaluate(()=>window.pickerError));
+    console.error(await page.evaluate(()=>({visible:document.visibilityState,outer:window.outerWidth})));
+    throw new Error('Desktop chooser did not open for '+selector);
