+#[test]
+fn probabilistic_shuffle_fixed_shared_control() -> Result<()> {
+    let mut reference = None;
+    for candidate in [false, true] {
+        ENABLED.set(candidate);
+        let (dir, job) = setup(20000)?;
+        let input_hash = blake3::hash(&fs::read(&job.input)?).to_hex().to_string();
+        let pool = Arc::new(crate::resources::MemoryPool::new(4 * 1024 * 1024));
+        let visits = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+        let seen = visits.clone();
+        let result = prepare_with_memory_pool(
+            job.clone(),
+            Arc::new(AtomicBool::new(false)),
+            Arc::new(move |p| {
+                if p.phase == "Reading and validating CSV" && p.rows == 0 {
+                    seen.fetch_add(1, Ordering::Relaxed);
+                }
+            }),
+            pool.clone(),
+        )
+        .and_then(|p| {
+            let ctx = p.ctx.clone();
+            let a = p.execute()?;
+            let d = ctx.diagnostics();
+            let checked = verify(dir.path(), &job, 20000, &a)?;
+            if let Some(ref old) = reference {
+                assert_eq!(&checked, old);
+            } else {
+                reference = Some(checked);
+            }
+            drop(a);
+            drop(ctx);
+            Ok(d)
+        });
+        let (outcome, diagnostics) = match result {
+            Ok(d) => ("success_exact", d),
+            Err(e) => {
+                assert!(
+                    matches!(
+                        e.downcast_ref::<crate::resources::MemoryAdmission>(),
+                        Some(crate::resources::MemoryAdmission::Shared { .. })
+                            | Some(crate::resources::MemoryAdmission::Local)
+                    ),
+                    "{e:#}"
+                );
+                assert!(!std::path::Path::new(&job.output).exists());
+                (
+                    "typed_memory_denial",
+                    serde_json::json!({"error":format!("{e:#}")}),
+                )
+            }
+        };
+        assert_eq!(fs::read_dir(dir.path().join("temp"))?.count(), 0);
+        assert!(!fs::read_dir(dir.path())?.any(|e| e
+            .unwrap()
+            .file_name()
+            .to_string_lossy()
+            .starts_with(".chopper-staging-")));
+        assert_eq!(pool.usage().reserved_bytes, 0);
+        assert_eq!(visits.load(Ordering::Relaxed), 1);
+        println!(
+            "PROB_SHUFFLE_FIXED {}",
+            serde_json::json!({"candidate":candidate,"outcome":outcome,"diagnostics":diagnostics,"shared_pool_bytes":4*1024*1024,"input_blake3":input_hash,"input_visits":1,"cleanup":true})
+        );
+    }
+    ENABLED.set(false);
+    Ok(())
+}
