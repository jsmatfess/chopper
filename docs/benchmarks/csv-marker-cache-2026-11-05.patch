+#[test]
+fn structural_cache_tracks_changing_unread_windows() -> anyhow::Result<()> {
+    let inputs: &[&[u8]] = &[
+        b"a,b,c,d\nnext,last,,\n",
+        b"a,b,c,d",
+        b"a,b,c,d\r\n\r\n\"x\ny\",z,\"q\"\"r\"\r\n",
+        "α,界,tail\n\"a,b\",\"x\"\"y\",z\n".as_bytes(),
+        b"a;\"b\\\"c\";d\n",
+        b"a,b\"c,d\n",
+        b"a,\"b\"junk\n",
+        b"a,\"b",
+        b"a,\xff,c\n",
+        b"a,b\rc,d\n",
+        b"a,,b,\n\n",
+        b"a\0b,c,d\n",
+    ];
+    for windows in [
+        &[65536, 1][..],
+        &[1, 65536],
+        &[8, 1, 4, 2, 65536],
+        &[3, 2, 1],
+    ] {
+        for input in inputs {
+            for maximum in [0, 1, 5, 31, 32, 37, 38, 63, 64, 65, 128, 4096] {
+                for custom in [false, true] {
+                    let settings = CsvSettings {
+                        delimiter: if custom { ';' } else { ',' },
+                        escape: custom.then_some('\\'),
+                        skip_empty_lines: custom,
+                        ..Default::default()
+                    };
+                    let mut reference = Parser::new(
+                        BufReader::with_capacity(1, *input),
+                        settings.clone(),
+                        maximum,
+                    );
+                    let mut owned =
+                        Parser::new(changing(input, windows), settings.clone(), maximum);
+                    let mut compact =
+                        Parser::new(changing(input, windows), settings.clone(), maximum);
+                    let mut admitted = Parser::new(changing(input, windows), settings, maximum);
+                    let mut record = CompactRecord::default();
+                    let mut fields = Vec::new();
+                    loop {
+                        let expected = reference.next_record();
+                        let actual = owned.next_record();
+                        let packed = compact.next_compact_record_into(&mut record);
+                        let reserved =
+                            admitted.next_record_into_reserved(&mut fields, &mut |_| Ok(()));
+                        assert_eq!(reference.record, owned.record);
+                        assert_eq!(reference.record, compact.record);
+                        assert_eq!(reference.record, admitted.record);
+                        match (expected, actual, packed, reserved) {
+                            (Ok(Some(expected)), Ok(Some(actual)), Ok(true), Ok(true)) => {
+                                assert_eq!(actual, expected);
+                                assert_eq!(record.fields().collect::<Vec<_>>(), expected);
+                                assert_eq!(fields, expected);
+                            }
+                            (Ok(None), Ok(None), Ok(false), Ok(false)) => {
+                                assert!(record.is_empty());
+                                assert!(fields.is_empty());
+                                break;
+                            }
+                            (Err(a), Err(b), Err(c), Err(d)) => {
+                                assert_eq!(format!("{a:#}"), format!("{b:#}"));
+                                assert_eq!(format!("{a:#}"), format!("{c:#}"));
+                                assert_eq!(format!("{a:#}"), format!("{d:#}"));
+                                assert!(record.is_empty());
+                                break;
+                            }
+                            results => panic!("changing window mismatch {windows:?}/{maximum}/{input:?}: {results:?}"),
+                        }
+                    }
+                }
+            }
+        }
+        for budget in 0..=320 {
+            let input = b"a,b,c,d\nthird,\"quoted\nfield\",last\n";
+            let mut compact = Parser::new(changing(input, windows), CsvSettings::default(), 4096);
+            let mut record = CompactRecord::default();
+            let mut granted = 0;
+            loop {
+                let result = compact.next_compact_record_into_reserved(&mut record, &mut |bytes| {
+                    anyhow::ensure!(bytes <= budget, "synthetic admission denial");
+                    granted = bytes;
+                    Ok(())
+                });
+                assert!(granted >= record.capacity() + compact.scratch_capacity());
+                if !matches!(result, Ok(true)) {
+                    break;
+                }
+            }
+            let mut admitted = Parser::new(changing(input, windows), CsvSettings::default(), 4096);
+            let mut fields = Vec::new();
+            let mut granted = 0;
+            loop {
+                let result = admitted.next_record_into_reserved(&mut fields, &mut |bytes| {
+                    anyhow::ensure!(bytes <= budget, "synthetic admission denial");
+                    granted = bytes;
+                    Ok(())
+                });
+                assert!(
+                    granted
+                        >= fields.capacity() * std::mem::size_of::<String>()
+                            + fields.iter().map(String::capacity).sum::<usize>()
+                            + admitted.scratch_capacity()
+                );
+                if !matches!(result, Ok(true)) {
+                    break;
+                }
+            }
+        }
+    }
+    Ok(())
+}
