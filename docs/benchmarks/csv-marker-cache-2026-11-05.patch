+#[test]
+fn structural_markers_preserve_literal_records_through_quotes_and_buffer_reuse(
+) -> anyhow::Result<()> {
+    let literal = "a,b,c\n\"x\ny\",z,\"q\"\"r\"\r\n,,\n界,\"with,comma\",tail";
+    let literal_rows: Vec<Vec<String>> = [
+        ["a", "b", "c"],
+        ["x\ny", "z", "q\"r"],
+        ["", "", ""],
+        ["界", "with,comma", "tail"],
+    ]
+    .into_iter()
+    .map(|row| row.into_iter().map(str::to_owned).collect())
+    .collect();
+    let wide: Vec<String> = (0..48).map(|column| format!("c{column}")).collect();
+    let mut quoted = wide.clone();
+    quoted[0] = "quoted,\n\"field".into();
+    quoted[47] = "界".into();
+    let wide_rows = vec![wide.clone(), quoted, wide];
+    let mut wide_input = Vec::new();
+    for row in &wide_rows {
+        wide_input.extend(chopper_core::csv::serialize(row, &CsvSettings::default())?);
+    }
+    for (input, expected) in [
+        (literal.as_bytes().to_vec(), literal_rows),
+        (wide_input, wide_rows),
+    ] {
+        for capacity in [1, 2, 3, 7, 16, 32, 64, 4096, 65536] {
+            let mut owned = Parser::new(
+                BufReader::with_capacity(capacity, input.as_slice()),
+                CsvSettings::default(),
+                8192,
+            );
+            let mut compact = Parser::new(
+                BufReader::with_capacity(capacity, input.as_slice()),
+                CsvSettings::default(),
+                8192,
+            );
+            let mut record = CompactRecord::default();
+            for row in &expected {
+                assert_eq!(owned.next_record()?.as_ref(), Some(row));
+                assert!(compact.next_compact_record_into(&mut record)?);
+                assert_eq!(
+                    record.fields().collect::<Vec<_>>(),
+                    row.iter().map(String::as_str).collect::<Vec<_>>()
+                );
+                assert_eq!(owned.record, compact.record);
+            }
+            assert!(owned.next_record()?.is_none());
+            assert!(!compact.next_compact_record_into(&mut record)?);
+        }
+    }
+    Ok(())
+}
