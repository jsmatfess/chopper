+// A conforming BufRead need not retain the previous fill_buf extent after
+// consume. Keep stream bytes fixed while independently changing its prefix.
+struct ChangingWindow<'a> {
+    remaining: &'a [u8],
+    windows: &'a [usize],
+    consumed: usize,
+}
+impl Read for ChangingWindow<'_> {
+    fn read(&mut self, output: &mut [u8]) -> io::Result<usize> {
+        let data = self.fill_buf()?;
+        let count = output.len().min(data.len());
+        output[..count].copy_from_slice(&data[..count]);
+        self.consume(count);
+        Ok(count)
+    }
+}
+impl BufRead for ChangingWindow<'_> {
+    fn fill_buf(&mut self) -> io::Result<&[u8]> {
+        let extent = self.windows[self.consumed % self.windows.len()];
+        Ok(&self.remaining[..extent.min(self.remaining.len())])
+    }
+    fn consume(&mut self, count: usize) {
+        assert!(count <= self.windows[self.consumed % self.windows.len()]);
+        self.remaining = &self.remaining[count..];
+        self.consumed += 1;
+    }
+}
+fn changing<'a>(input: &'a [u8], windows: &'a [usize]) -> ChangingWindow<'a> {
+    ChangingWindow {
+        remaining: input,
+        windows,
+        consumed: 0,
+    }
+}
