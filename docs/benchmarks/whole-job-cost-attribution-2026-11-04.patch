+#[test]
+fn probabilistic_shuffle_cost_attribution() -> Result<()> {
+    chopper_core::csv::research_costs::reset(true);
+    let calibration_start = std::time::Instant::now();
+    for _ in 0..100000 {
+        drop(chopper_core::csv::research_costs::start(0));
+    }
+    let calibration_seconds = calibration_start.elapsed().as_secs_f64();
+    let calibration = chopper_core::csv::research_costs::finish();
+    assert_eq!(calibration[0].1, 100000);
+    println!(
+        "COST_CALIBRATION {}",
+        serde_json::json!({"iterations":100000,"seconds":calibration_seconds,"counters":calibration})
+    );
+
+    let label = "cost-attribution";
+    let n = 200000;
+    let schedule = [(false, false), (false, true), (true, false), (true, true)];
+    let mut last_recipe = None;
+    let mut reference = None;
+    for (rep, (fusion_recipe, instrumented)) in schedule.into_iter().enumerate() {
+        let candidate = true;
+        let grouping = Grouping::Auto;
+        if last_recipe != Some(fusion_recipe) {
+            reference = None;
+        }
+        last_recipe = Some(fusion_recipe);
+        ENABLED.set(candidate);
+        let (dir, mut job) = setup(n)?;
+        job.resources.grouping = grouping;
+        if !fusion_recipe {
+            job.operations.clear();
+        }
+        let input_hash = blake3::hash(&fs::read(&job.input)?).to_hex().to_string();
+        let pool = Arc::new(crate::resources::MemoryPool::new(32 * 1024 * 1024));
+        chopper_core::csv::research_costs::reset(instrumented);
+        let started = std::time::Instant::now();
+        let prepared = prepare_with_memory_pool(
+            job.clone(),
+            Arc::new(AtomicBool::new(false)),
+            Arc::new(|_| {}),
+            pool.clone(),
+        )?;
+        let ctx = prepared.ctx.clone();
+        let a = prepared.execute()?;
+        let seconds = started.elapsed().as_secs_f64();
+        let costs = chopper_core::csv::research_costs::finish();
+        let phases = serde_json::to_value(&a.timings)?;
+        let diagnostics = ctx.diagnostics();
+        // Verification is outside the complete engine preparation/publication timer.
+        let checked = verify(dir.path(), &job, n, &a)?;
+        if let Some(ref old) = reference {
+            assert_eq!(&checked, old);
+        } else {
+            reference = Some(checked);
+        }
+        drop(a);
+        drop(ctx);
+        assert_eq!(fs::read_dir(dir.path().join("temp"))?.count(), 0);
+        assert_eq!(pool.usage().reserved_bytes, 0);
+        println!(
+            "COST_ATTRIBUTION {}",
+            serde_json::json!({"label":label,"fusion_recipe":fusion_recipe,"instrumented":instrumented,"costs":costs,"phases":phases,"grouping":match grouping { Grouping::Auto => "auto", Grouping::Sort => "sort" },"rows":n,"candidate":candidate,"rep":rep,"seconds":seconds,"input_blake3":input_hash,"diagnostics":diagnostics,"exact_output_verified":true,"cleanup":true})
+        );
+    }
+    ENABLED.set(false);
+    Ok(())
+}
