+/// Private experiment instrumentation, absent from production source.
+#[doc(hidden)]
+pub mod research_costs {
+    use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+    use std::time::Instant;
+    static ENABLED: AtomicBool = AtomicBool::new(false);
+    static NS: [AtomicU64; 6] = [const { AtomicU64::new(0) }; 6];
+    static CALLS: [AtomicU64; 6] = [const { AtomicU64::new(0) }; 6];
+    pub struct Span(usize, Instant);
+    pub fn start(slot: usize) -> Option<Span> {
+        ENABLED
+            .load(Ordering::Relaxed)
+            .then(|| Span(slot, Instant::now()))
+    }
+    impl Drop for Span {
+        fn drop(&mut self) {
+            let elapsed = self.1.elapsed().as_nanos().min(u64::MAX as u128) as u64;
+            NS[self.0].fetch_add(elapsed, Ordering::Relaxed);
+            CALLS[self.0].fetch_add(1, Ordering::Relaxed);
+        }
+    }
+    pub fn reset(enabled: bool) {
+        ENABLED.store(false, Ordering::Relaxed);
+        for v in NS.iter().chain(CALLS.iter()) {
+            v.store(0, Ordering::Relaxed);
+        }
+        ENABLED.store(enabled, Ordering::Relaxed);
+    }
+    pub fn finish() -> Vec<(&'static str, u64, u64)> {
+        ENABLED.store(false, Ordering::Relaxed);
+        [
+            "parse_inclusive",
+            "decode_nested_in_parse",
+            "logical_digest",
+            "random_block_nested_in_categorical_or_key",
+            "categorical_inclusive",
+            "serialize_reserved",
+        ]
+        .into_iter()
+        .enumerate()
+        .map(|(i, n)| {
+            (
+                n,
+                CALLS[i].load(Ordering::Relaxed),
+                NS[i].load(Ordering::Relaxed),
+            )
+        })
+        .collect()
+    }
+}
