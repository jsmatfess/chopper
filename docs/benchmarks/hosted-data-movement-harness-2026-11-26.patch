+// Derive the quotas and paths from the Job, independently of the engine report.
+function groupsFor(rows, operations) {
+  let groups=[{rows,lineage:[]}];
+  const stages=operations.map((op,operation)=>{
+    const parents=groups.length;
+    if(op.type==='balanced') {
+      groups=groups.flatMap(parent=>Array.from({length:op.files},(_,part)=>({
+        rows:Math.floor(parent.rows/op.files)+Number(part<parent.rows%op.files),
+        lineage:[...parent.lineage,{operation,part:part+1}],
+      })));
+    }
+    return [operation+1, parents, groups.length,
+      Math.min(...groups.map(group=>group.rows)),Math.max(...groups.map(group=>group.rows)),0];
+  });
+  return {groups,stages};
+}
