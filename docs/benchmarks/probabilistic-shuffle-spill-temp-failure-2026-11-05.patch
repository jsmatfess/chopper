+#[cfg(test)]
+mod prepared_spill_failure_controls {
+    use super::*;
+
+    #[test]
+    fn prepared_spill_write_failure_cleanup() -> Result<()> {
+        for maximum in [1u64, 65536] {
+            let dir = tempfile::tempdir()?;
+            let temp = dir.path().join("temp");
+            std::fs::create_dir(&temp)?;
+            let pool = Arc::new(crate::resources::MemoryPool::new(32 * 1024 * 1024));
+            let ctx = Context::with_memory_pool(
+                &chopper_core::Resources {
+                    memory_mb: 32.into(),
+                    workers: 1,
+                    temp_dir: Some(temp.to_string_lossy().into()),
+                    temp_bytes: Some(maximum),
+                    max_record_bytes: 1024 * 1024,
+                    ..Default::default()
+                },
+                Arc::new(AtomicBool::new(false)),
+                Arc::new(|_| {}),
+                pool.clone(),
+            )?;
+            let retained = pool.usage().reserved_bytes;
+            let mut sorter = Sorter::with_available_capacity(&ctx, SortOrder::Random([7; 32]))?;
+            ensure!(
+                sorter.prepared_spill.is_some(),
+                "missing real prepared owner"
+            );
+            sorter.push(Row {
+                id: 0,
+                ordinal: 0,
+                key: vec![1; 16],
+                fields: vec!["x".repeat(128 * 1024)],
+            })?;
+            let error = sorter.flush().expect_err("spill write unexpectedly fit");
+            ensure!(
+                format!("{error:#}").contains("temporary-space budget exhausted"),
+                "{error:#}"
+            );
+            let prefix = ctx.budget.written.load(AtomicOrdering::Relaxed);
+            ensure!(prefix <= maximum, "budget exceeded");
+            ensure!(
+                (maximum == 1 && prefix == 0) || (maximum == 65536 && prefix > 0),
+                "wrong partial-write exposure"
+            );
+            let diagnostics = ctx.diagnostics();
+            ensure!(diagnostics["sort_runs"] == 1, "spill path not exercised");
+            drop(sorter);
+            ensure!(ctx.used() == 0, "failed writer bytes leaked");
+            ensure!(
+                pool.usage().reserved_bytes == retained,
+                "failed writer grants leaked"
+            );
+            ensure!(
+                std::fs::read_dir(ctx.dir.path())?.next().is_none(),
+                "failed file leaked"
+            );
+            drop(ctx);
+            ensure!(pool.usage().reserved_bytes == 0, "context grant leaked");
+            ensure!(
+                std::fs::read_dir(&temp)?.next().is_none(),
+                "job directory leaked"
+            );
+            println!(
+                "PROB_SPILL_WRITE_FAILURE {}",
+                serde_json::json!({"temp_budget":maximum,"written_prefix_bytes":prefix,"sort_runs":1,"error":format!("{error:#}"),"real_prepared_owner":true,"retained_row_bytes":128*1024,"cleanup":true,"final_pool_reserved":0})
+            );
+        }
+        Ok(())
+    }
+}
