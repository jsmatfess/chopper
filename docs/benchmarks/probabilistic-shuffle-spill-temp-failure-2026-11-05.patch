+#[test]
+fn probabilistic_shuffle_prepared_spill_temp_budget() -> Result<()> {
+    let mut reference = None;
+    for (label, candidate, maximum) in [
+        ("reference", false, 256u64 * 1024 * 1024),
+        ("limited-baseline", false, 64 * 1024 * 1024),
+        ("limited-candidate", true, 64 * 1024 * 1024),
+    ] {
+        ENABLED.set(candidate);
+        let (dir, mut job) = setup(200000)?;
+        job.resources.temp_bytes = Some(maximum);
+        let owner_events = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+        let owner_seen = owner_events.clone();
+        let _hook = target_hook(move |point, _| {
+            if point == "after" {
+                owner_seen.fetch_add(1, Ordering::Relaxed);
+            }
+        });
+        let input_hash = blake3::hash(&fs::read(&job.input)?).to_hex().to_string();
+        let pool = Arc::new(crate::resources::MemoryPool::new(32 * 1024 * 1024));
+        let visits = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+        let seen = visits.clone();
+        let last = Arc::new(std::sync::Mutex::new(serde_json::Value::Null));
+        let observed = last.clone();
+        let result = prepare_with_memory_pool(
+            job.clone(), Arc::new(AtomicBool::new(false)),
+            Arc::new(move |progress| {
+                if progress.phase == "Reading and validating CSV" && progress.rows == 0 { seen.fetch_add(1, Ordering::Relaxed); }
+                *observed.lock().unwrap() = serde_json::json!({"phase":progress.phase,"rows":progress.rows,"temp_bytes":progress.temp_bytes});
+            }), pool.clone(),
+        ).and_then(|prepared| {
+            let ctx = prepared.ctx.clone();
+            let analysis = prepared.execute()?;
+            let checked = verify(dir.path(), &job, 200000, &analysis)?;
+            if let Some(ref expected) = reference { assert_eq!(&checked, expected); } else { reference = Some(checked.clone()); }
+            let fingerprint = blake3::hash(&serde_json::to_vec(&checked)?).to_hex().to_string();
+            let details = serde_json::json!({"verified_fingerprint_blake3":fingerprint,"peak_temp_bytes":ctx.peak(),"diagnostics":ctx.diagnostics(),"output_files":analysis.output_files,"output_csv_bytes":analysis.output_csv_bytes,"exact_csv_output_analysis":true});
+            drop(analysis); drop(ctx); Ok(details)
+        });
+        let (outcome, details) = match result {
+            Ok(details) => ("success_exact", details),
+            Err(error) => {
+                ensure!(label != "reference", "reference failed: {error:#}");
+                ensure!(
+                    format!("{error:#}").contains("temporary-space budget exhausted"),
+                    "{error:#}"
+                );
+                ensure!(
+                    !std::path::Path::new(&job.output).exists(),
+                    "failure published output"
+                );
+                (
+                    "temporary_budget_denial",
+                    serde_json::json!({"error":format!("{error:#}"),"debug":format!("{error:?}")}),
+                )
+            }
+        };
+        ensure!(visits.load(Ordering::Relaxed) == 1, "input replayed");
+        ensure!(
+            fs::read_dir(dir.path().join("temp"))?.next().is_none(),
+            "temporary data leaked"
+        );
+        ensure!(
+            !fs::read_dir(dir.path())?.any(|e| e
+                .unwrap()
+                .file_name()
+                .to_string_lossy()
+                .starts_with(".chopper-staging-")),
+            "private staging leaked"
+        );
+        ensure!(pool.usage().reserved_bytes == 0, "pool leaked");
+        println!(
+            "PROB_SPILL_TEMP_JOB {}",
+            serde_json::json!({"label":label,"candidate":candidate,"temp_budget":maximum,"rows":200000,"input_blake3":input_hash,"outcome":outcome,"details":details,"owner_constructions":owner_events.load(Ordering::Relaxed),"last_progress":*last.lock().unwrap(),"input_visits":1,"cleanup":true,"final_pool_reserved":0,"performance_measurement":false})
+        );
+    }
+    ENABLED.set(false);
+    Ok(())
+}
