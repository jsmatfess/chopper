+                serde_json::json!({"rep":rep,"parallel":parallel,"workers":workers,"memory_mb":128,"rows":200000,"input_blake3":input_hash,"seconds":seconds,"peak_active_chunks":peak,"whole_run_peak_reserved_bytes":usage.peak_reserved_bytes,"retained_analysis_reserved_bytes":usage.reserved_bytes,"prepublication_diagnostics":prepublication_diagnostics,"exact_output_verified":true,"resource_invariant_analysis_fields":16,"workers_verified_separately":true,"cleanup":true})
+            );
+        }
+        research_publication::set(false);
+        Ok(())
+    }
