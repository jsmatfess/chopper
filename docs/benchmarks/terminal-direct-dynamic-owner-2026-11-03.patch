+#[test]
+fn terminal_dynamic_matched_owner_controls() -> Result<()> {
+    use crate::resources::MemoryAdmission;
+    use crate::storage::Workspace;
+    use std::collections::{BTreeMap, BTreeSet};
+    use std::sync::{atomic::AtomicUsize, Mutex};
+    const MIB: u64 = 1024 * 1024;
+    let mut text = String::from("id,kind,text\n");
+    for id in 0..65537 {
+        let payload = if id == 65536 {
+            "x".repeat(16384)
+        } else {
+            format!("value-{id}")
+        };
+        text.push_str(&format!("{id},A,{payload}\n"));
+    }
+    let mut reference = None;
+    for mode in ["held", "released", "deny-final", "cancel-final"] {
+        for direct in [false, true] {
+            let (dir, mut job) = setup(text.as_bytes())?;
+            job.limits.rows = Some(2000);
+            job.limits.bytes = Some(65536);
+            let pool = Arc::new(MemoryPool::new(32 * MIB));
+            let owner_space = Arc::new(Workspace::shared(32 * MIB as usize, pool.clone()));
+            let owner = Arc::new(Mutex::new(Reservation::for_workspace(owner_space.clone())));
+            let events = Arc::new(Mutex::new(Vec::new()));
+            let visits = Arc::new(AtomicUsize::new(0));
+            let injected = Arc::new(AtomicBool::new(false));
+            let finalized = Arc::new(AtomicBool::new(false));
+            let cancel = Arc::new(AtomicBool::new(false));
+            let notify: Notify = {
+                let (pool, owner, events, visits, injected, finalized, cancel) = (
+                    pool.clone(),
+                    owner.clone(),
+                    events.clone(),
+                    visits.clone(),
+                    injected.clone(),
+                    finalized.clone(),
+                    cancel.clone(),
+                );
+                Arc::new(move |p| {
+                    if p.phase == "Reading and validating CSV" && p.rows == 0 {
+                        visits.fetch_add(1, Ordering::Relaxed);
+                    }
+                    let terminal = p.phase
+                        == if direct {
+                            "Finalizing direct terminal output"
+                        } else {
+                            "Ready for confirmation"
+                        };
+                    if p.phase == "Serializing output" {
+                        assert_eq!(p.rows, 65536);
+                        assert!(!injected.swap(true, Ordering::Relaxed));
+                        owner.lock().unwrap().resize((16 * MIB) as usize).unwrap();
+                        events.lock().unwrap().push(serde_json::json!({
+                            "phase":p.phase.as_str(), "rows":p.rows,
+                            "grant":owner.lock().unwrap().bytes(), "pool_reserved":pool.usage().reserved_bytes,
+                        }));
+                    }
+                    if terminal {
+                        assert!(!finalized.swap(true, Ordering::Relaxed));
+                        let mut grant = owner.lock().unwrap();
+                        if mode == "released" {
+                            grant.resize(0).unwrap();
+                        }
+                        if mode == "deny-final" || mode == "cancel-final" {
+                            let usage = pool.usage();
+                            let target = grant.bytes() + usage.limit_bytes - usage.reserved_bytes;
+                            grant.resize(target as usize).unwrap();
+                        }
+                        events.lock().unwrap().push(serde_json::json!({
+                            "phase":p.phase.as_str(), "rows":p.rows,
+                            "grant":grant.bytes(), "pool_reserved":pool.usage().reserved_bytes,
+                        }));
+                        if mode == "cancel-final" {
+                            cancel.store(true, Ordering::Relaxed);
+                        }
+                    }
+                })
+            };
+            let result = if direct {
+                run_with_memory_pool(job.clone(), cancel, notify, pool.clone())
+            } else {
+                prepare_with_memory_pool(job.clone(), cancel, notify, pool.clone())
+                    .and_then(|p| p.execute())
+            };
+            assert!(injected.load(Ordering::Relaxed));
+            assert!(finalized.load(Ordering::Relaxed));
+            assert_eq!(visits.load(Ordering::Relaxed), 1, "no raw replay");
+            let outcome;
+            if mode == "held" || mode == "released" {
+                let a = result?;
+                assert_eq!(a.rows, 65537);
+                let mut files = BTreeMap::new();
+                let mut ids = BTreeSet::new();
+                let mut output_records = Vec::new();
+                for entry in fs::read_dir(&job.output)? {
+                    let entry = entry?;
+                    let name = entry.file_name().to_string_lossy().into_owned();
+                    let bytes = fs::read(entry.path())?;
+                    if name.ends_with(".csv") {
+                        assert!(bytes.len() <= 65536);
+                        // This frozen fixture contains no CSV quoting or embedded delimiters.
+                        // Independently parse its plain ASCII records rather than use engine parsing.
+                        let decoded = std::str::from_utf8(&bytes)?;
+                        let mut lines = decoded.lines();
+                        assert_eq!(lines.next(), Some("id,kind,text"));
+                        let mut rows = 0;
+                        for line in lines {
+                            let record: Vec<_> = line.split(',').collect();
+                            assert_eq!(record.len(), 3);
+                            let id = record[0].parse::<usize>()?;
+                            assert!(ids.insert(id), "unique ID");
+                            assert_eq!(record[1], "A");
+                            let expected = if id == 65536 {
+                                "x".repeat(16384)
+                            } else {
+                                format!("value-{id}")
+                            };
+                            assert_eq!(record[2], expected);
+                            rows += 1;
+                        }
+                        assert!(rows <= 2000);
+                        files.insert(name, bytes);
+                    } else {
+                        assert_eq!(name, "manifest.jsonl");
+                        for line in bytes.split(|b| *b == b'\n').filter(|line| !line.is_empty()) {
+                            let v: serde_json::Value = serde_json::from_slice(line)?;
+                            if v["type"] == "output" {
+                                output_records.push(v);
+                            }
+                        }
+                    }
+                }
+                assert_eq!(ids, (0..65537).collect());
+                assert_eq!(files.len() as u64, a.output_files);
+                let analysis = serde_json::to_value(&a)?;
+                let logical: serde_json::Map<String, serde_json::Value> = [
+                    "algorithm_version",
+                    "column_values",
+                    "seed",
+                    "rows",
+                    "columns",
+                    "header",
+                    "preview",
+                    "logical_digest",
+                    "groups",
+                    "output_files",
+                    "output_csv_bytes",
+                    "largest_record_bytes",
+                    "memory_budget_bytes",
+                    "workers",
+                    "stages",
+                    "warnings",
+                    "accuracy",
+                ]
+                .into_iter()
+                .map(|key| (key.into(), analysis[key].clone()))
+                .collect();
+                let compared = (files, output_records, logical);
+                if let Some(reference) = &reference {
+                    assert_eq!(&compared, reference);
+                } else {
+                    reference = Some(compared);
+                }
+                drop(a);
+                fs::remove_dir_all(&job.output)?;
+                outcome = "success_exact";
+            } else {
+                let e = result.expect_err("terminal denial/cancellation");
+                if mode == "cancel-final" {
+                    assert!(format!("{e:#}").contains("job cancelled"), "{e:#}");
+                    outcome = "cancelled";
+                } else {
+                    assert!(
+                        matches!(
+                            e.downcast_ref::<MemoryAdmission>(),
+                            Some(MemoryAdmission::Shared { .. })
+                        ),
+                        "{e:#}"
+                    );
+                    outcome = "typed_shared_denial";
+                }
+            }
+            clean(dir.path(), &job)?;
+            let held = owner.lock().unwrap().bytes();
+            assert_eq!(
+                pool.usage().reserved_bytes,
+                held,
+                "only competitor survives"
+            );
+            assert_eq!(owner_space.used(), held);
+            owner.lock().unwrap().resize(0)?;
+            assert_eq!(pool.usage().reserved_bytes, 0);
+            println!(
+                "TERMINAL_DYNAMIC {}",
+                serde_json::json!({
+                    "direct":direct,"mode":mode,"outcome":outcome,"events":*events.lock().unwrap(),
+                    "rows":65537,"pool_bytes":32*MIB,"matched_emission_grant_bytes":16*MIB,
+                    "input_visits":visits.load(Ordering::Relaxed),"cleanup":true,"final_pool_reserved_bytes":0,
+                    "retained_competitor_bytes_after_job":held,
+                })
+            );
+        }
+    }
+    Ok(())
+}
