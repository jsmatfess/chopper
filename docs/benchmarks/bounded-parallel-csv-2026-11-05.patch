+        let parser = Parser::new(
+            BufReader::with_capacity(capacity, Cursor::new(data)),
+            chopper_core::CsvSettings::default(),
+            maximum,
+        );
+        if batch {
+            collect(
+                ParallelRecords::new(parser, &job(), ctx, maximum),
+                compact,
+                ctx,
+            )
+        } else {
+            collect(parser, compact, ctx)
+        }
+    }
+    #[test]
+    fn parallel_csv_strict_refill_working_and_order_controls() -> Result<()> {
+        let (_dir, ctx, pool) = context()?;
+        let held = pool.usage().reserved_bytes;
+        let cases: &[&[u8]] = &[
+            b"",
+            b"a,b\nnext,last\n",
+            b"a,b",
+            b"a,,\n",
+            b"\n",
+            b"\"\"\n",
+            b"a,b\rc,d\n",
+            b"\ra,b\n",
+            b"ab\"c,d\nnext,row\n",
+            b"\"a\"x,b\n",
+            b"\"a\nline\",b\r\n",
+            b"a,\"b\"\"c\"\n",
+            b"\"unterminated",
+            b"a,\xff\n",
+            b"ok,row\nbad,\"unterminated",
+            "α,界\nnext,é\n".as_bytes(),
+        ];
+        for data in cases {
+            for capacity in [1, 2, 7, 64, 65536] {
+                for maximum in [1, 5, 31, 32, 37, 38, 128, 4096] {
+                    for compact in [false, true] {
+                        assert_eq!(
+                            parse(data, capacity, maximum, true, compact, &ctx)?,
+                            parse(data, capacity, maximum, false, compact, &ctx)?,
+                            "input={data:?},cap={capacity},max={maximum},compact={compact}"
+                        );
+                        assert_eq!(pool.usage().reserved_bytes, held);
+                    }
+                }
+            }
+        }
+        let mut many = String::new();
+        for id in 0..5000 {
+            many.push_str(&format!("{id},\"row {id}\nline\"\n"));
+        }
+        let wide = format!("small,row\n{},tail\nlast,row\n", "x".repeat(200000));
+        for input in [many, wide] {
+            for compact in [false, true] {
+                assert_eq!(
+                    parse(input.as_bytes(), 65536, 1048576, true, compact, &ctx)?,
+                    parse(input.as_bytes(), 65536, 1048576, false, compact, &ctx)?
+                );
+            }
+        }
+        assert_eq!(pool.usage().reserved_bytes, held);
+        drop(ctx);
+        assert_eq!(pool.usage().reserved_bytes, 0);
+        Ok(())
+    }
+    struct Fault<'a> {
+        data: &'a [u8],
+    }
+    impl io::Read for Fault<'_> {
+        fn read(&mut self, out: &mut [u8]) -> io::Result<usize> {
+            let data = self.fill_buf()?;
+            let n = data.len().min(out.len());
+            out[..n].copy_from_slice(&data[..n]);
+            self.consume(n);
+            Ok(n)
+        }
+    }
+    impl BufRead for Fault<'_> {
+        fn fill_buf(&mut self) -> io::Result<&[u8]> {
+            if self.data.is_empty() {
+                Err(io::Error::other("injected trailing read error"))
+            } else {
+                Ok(self.data)
+            }
+        }
+        fn consume(&mut self, n: usize) {
+            self.data = &self.data[n..];
+        }
+    }
+    #[test]
+    fn parallel_csv_deferred_errors_admission_and_cancellation() -> Result<()> {
+        let (_dir, ctx, pool) = context()?;
+        let retained = pool.usage().reserved_bytes;
+        for data in [
+            b"first,row\nsecond,row\n".as_slice(),
+            b"first,row\npartial",
+            b"ab\"c,d\n",
+            b"first,row\n\"unterminated",
+        ] {
+            for compact in [false, true] {
+                let parser = Parser::new(
+                    Fault { data },
+                    chopper_core::CsvSettings::default(),
+                    1048576,
+                );
+                let expected = collect(parser, compact, &ctx)?;
+                let parser = Parser::new(
+                    Fault { data },
+                    chopper_core::CsvSettings::default(),
+                    1048576,
+                );
+                assert_eq!(
+                    collect(
+                        ParallelRecords::new(parser, &job(), &ctx, 1048576),
+                        compact,
+                        &ctx
+                    )?,
+                    expected
+                );
+            }
+        }
+        let mut peer =
+            Reservation::for_workspace(Arc::new(Workspace::shared(32 * 1024 * 1024, pool.clone())));
+        peer.resize(32 * 1024 * 1024 - retained as usize - 16384)?;
+        let held = pool.usage().reserved_bytes;
+        let mut memory = Reservation::new(&ctx);
+        let parser = Parser::new(
+            Cursor::new(b"a,b\n"),
+            chopper_core::CsvSettings::default(),
+            1048576,
+        );
+        let mut parser = ParallelRecords::new(parser, &job(), &ctx, 1048576);
+        let mut fields = Vec::new();
+        let error = parser
+            .next_record_into_reserved(&mut fields, &mut |n| memory.resize(n))
+            .unwrap_err();
+        assert!(error
+            .downcast_ref::<crate::resources::MemoryAdmission>()
+            .is_some());
+        drop(fields);
+        drop(parser);
+        drop(memory);
+        assert_eq!(pool.usage().reserved_bytes, held);
+        drop(peer);
+        drop(ctx);
+        assert_eq!(pool.usage().reserved_bytes, 0);
+        let dir = tempfile::tempdir()?;
+        let pool = Arc::new(crate::resources::MemoryPool::new(32 * 1024 * 1024));
+        let signal = Arc::new(AtomicBool::new(false));
+        let ctx = Context::with_memory_pool(
+            &chopper_core::Resources {
+                memory_mb: 32.into(),
+                workers: 4,
+                max_record_bytes: 1048576,
+                temp_dir: Some(dir.path().to_string_lossy().into()),
+                ..Default::default()
+            },
+            signal.clone(),
+            Arc::new(|_| {}),
+            pool.clone(),
+        )?;
+        let mut memory = Reservation::new(&ctx);
+        let parser = Parser::new(
+            Cursor::new(b"a,b\n"),
+            chopper_core::CsvSettings::default(),
+            1048576,
+        );
+        let mut parser = ParallelRecords::new(parser, &job(), &ctx, 1048576);
+        signal.store(true, std::sync::atomic::Ordering::Relaxed);
+        let mut fields = Vec::new();
+        assert!(format!(
+            "{:#}",
+            parser
+                .next_record_into_reserved(&mut fields, &mut |n| memory.resize(n))
+                .unwrap_err()
+        )
+        .contains("cancel"));
+        drop(fields);
+        drop(parser);
+        drop(memory);
+        drop(ctx);
+        assert_eq!(pool.usage().reserved_bytes, 0);
+        assert!(std::fs::read_dir(dir.path())?.next().is_none());
+        Ok(())
+    }
+    thread_local! {
+        static FORCE_SERIAL: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+        static AFTER_BATCH: std::cell::RefCell<Option<Box<dyn FnMut()>>> = const { std::cell::RefCell::new(None) };
+    }
+    pub(super) fn force_serial() -> bool {
+        FORCE_SERIAL.get()
+    }
+    pub(super) fn after_batch() {
+        AFTER_BATCH.with(|slot| {
+            if let Some(hook) = slot.borrow_mut().as_mut() {
+                hook();
+            }
+        });
+    }
+    struct Reset;
+    impl Drop for Reset {
+        fn drop(&mut self) {
+            FORCE_SERIAL.set(false);
+            AFTER_BATCH.with(|slot| {
+                slot.borrow_mut().take();
+            });
+        }
+    }
+    fn input() -> Result<Vec<u8>> {
+        let mut input = b"id,region,payload\n".to_vec();
+        for id in 0..3000 {
+            input.extend(chopper_core::csv::serialize(
+                &[
+                    id.to_string(),
+                    format!("R{}", id % 4),
+                    format!("héllô,\nline \"{id}\""),
+                ],
+                &chopper_core::CsvSettings::default(),
+            )?);
+        }
+        Ok(input)
+    }
+    fn checked(job: &Job, analysis: &Analysis) -> Result<serde_json::Value> {
+        let mut files = std::collections::BTreeMap::new();
+        let mut outputs = Vec::new();
+        let mut seen = std::collections::BTreeSet::new();
+        for entry in std::fs::read_dir(&job.output)? {
+            let entry = entry?;
+            let name = entry.file_name().to_string_lossy().into_owned();
+            let data = std::fs::read(entry.path())?;
+            if name.ends_with(".csv") {
+                assert!(data.len() <= 65536);
+                let mut parser = Parser::new(
+                    std::io::Cursor::new(&data),
+                    chopper_core::CsvSettings::default(),
+                    1048576,
+                );
+                assert_eq!(parser.next_record()?.unwrap(), ["id", "region", "payload"]);
+                let mut count = 0;
+                while let Some(fields) = parser.next_record()? {
+                    let id = fields[0].parse::<usize>()?;
+                    assert!(id < 3000 && seen.insert(id));
+                    assert_eq!(
+                        fields,
+                        [
+                            id.to_string(),
+                            format!("R{}", id % 4),
+                            format!("héllô,\nline \"{id}\"")
+                        ]
+                    );
+                    count += 1;
+                }
+                assert!(count <= 512);
+                files.insert(name, data);
+            } else {
+                for line in data.split(|b| *b == b'\n').filter(|x| !x.is_empty()) {
+                    let r: serde_json::Value = serde_json::from_slice(line)?;
+                    if r["type"] == "output" {
+                        outputs.push(r);
+                    }
+                }
+            }
+        }
+        assert_eq!(seen, (0..3000).collect());
+        assert_eq!(analysis.rows, 3000);
+        assert_eq!(analysis.output_files, files.len() as u64);
+        let all = serde_json::to_value(analysis)?;
+        let logical: serde_json::Map<String, serde_json::Value> = [
+            "algorithm_version",
+            "column_values",
+            "seed",
+            "rows",
+            "columns",
+            "header",
+            "preview",
+            "logical_digest",
+            "groups",
+            "output_files",
+            "output_csv_bytes",
+            "largest_record_bytes",
+            "memory_budget_bytes",
+            "workers",
+            "stages",
+            "warnings",
+            "accuracy",
+        ]
+        .into_iter()
+        .map(|k| (k.into(), all[k].clone()))
+        .collect();
+        Ok(serde_json::json!({"files":files,"outputs":outputs,"analysis":logical}))
+    }
+    #[test]
+    fn parallel_csv_complete_run_controls() -> Result<()> {
+        let _reset = Reset;
+        for pipeline in [false, true] {
+            for case in ["valid", "width", "quote", "cancel"] {
+                let mut reference = None;
+                for parallel in if case == "cancel" {
+                    vec![true]
+                } else {
+                    vec![false, true]
+                } {
+                    FORCE_SERIAL.set(!parallel);
+                    let dir = tempfile::tempdir()?;
+                    let temp = dir.path().join("temp");
+                    std::fs::create_dir(&temp)?;
+                    let path = dir.path().join("input.csv");
+                    let mut bytes = input()?;
+                    if case == "width" {
+                        bytes.extend_from_slice(b"3000,R0,payload,extra\n");
+                    }
+                    if case == "quote" {
+                        bytes.extend_from_slice(b"3000,R0,ab\"c\n");
+                    }
+                    std::fs::write(&path, bytes)?;
+                    let mut job = Job {
+                        input: path.to_string_lossy().into(),
+                        output: dir.path().join("output").to_string_lossy().into(),
+                        seed: Some("parallel-csv-control-v1".into()),
+                        ..Default::default()
+                    };
+                    if pipeline {
+                        job.operations = vec![
+                            Operation::Partition {
+                                columns: vec![chopper_core::Column::Index(1)],
+                            },
+                            Operation::AssignProbabilistic {
+                                groups: vec![
+                                    chopper_core::Allocation {
+                                        name: "treatment".into(),
+                                        percent: "80".into(),
+                                    },
+                                    chopper_core::Allocation {
+                                        name: "control".into(),
+                                        percent: "20".into(),
+                                    },
+                                    chopper_core::Allocation {
+                                        name: "empty".into(),
+                                        percent: "0".into(),
+                                    },
+                                ],
+                                strata: vec![],
+                            },
+                            Operation::Shuffle {
+                                strategy: chopper_core::Shuffle::Uniform,
+                            },
+                        ];
+                    }
+                    job.resources.memory_mb = 32.into();
+                    job.resources.workers = 4;
+                    job.resources.max_record_bytes = 1048576;
+                    job.resources.temp_dir = Some(temp.to_string_lossy().into());
+                    job.limits.rows = Some(512);
+                    job.limits.bytes = Some(65536);
+                    let pool = Arc::new(crate::resources::MemoryPool::new(32 * 1024 * 1024));
+                    let signal = Arc::new(AtomicBool::new(false));
+                    let batches = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+                    if case == "cancel" {
+                        let signal = signal.clone();
+                        let count = batches.clone();
+                        AFTER_BATCH.with(|slot| {
+                            *slot.borrow_mut() = Some(Box::new(move || {
+                                if count.fetch_add(1, std::sync::atomic::Ordering::Relaxed) == 1 {
+                                    signal.store(true, std::sync::atomic::Ordering::Relaxed);
+                                }
+                            }))
+                        });
+                    }
+                    let visits = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+                    let count = visits.clone();
+                    let result = run_with_memory_pool(
+                        job.clone(),
+                        signal.clone(),
+                        Arc::new(move |p| {
+                            if matches!(
+                                p.phase.as_str(),
+                                "Reading and validating CSV" | "Reading and writing CSV"
+                            ) && p.rows == 0
+                            {
+                                count.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+                            }
+                        }),
+                        pool.clone(),
+                    );
+                    let outcome = match result {
+                        Ok(analysis) => {
+                            assert_eq!(case, "valid");
+                            let value = checked(&job, &analysis)?;
+                            if let Some(ref prior) = reference {
+                                assert_eq!(&value, prior);
+                            } else {
+                                reference = Some(value);
+                            }
+                            drop(analysis);
+                            "success_exact"
+                        }
+                        Err(error) => {
+                            assert_ne!(case, "valid", "{error:#}");
+                            let text = format!("{error:#}");
+                            if case == "cancel" {
+                                assert!(text.contains("cancel"));
+                                assert!(batches.load(std::sync::atomic::Ordering::Relaxed) >= 2);
+                            } else {
+                                if let Some(ref prior) = reference {
+                                    assert_eq!(&serde_json::Value::String(text.clone()), prior);
+                                } else {
+                                    reference = Some(serde_json::Value::String(text));
+                                }
+                            }
+                            assert!(!std::path::Path::new(&job.output).exists());
+                            "terminal_error"
+                        }
+                    };
+                    AFTER_BATCH.with(|slot| {
+                        slot.borrow_mut().take();
+                    });
+                    assert_eq!(visits.load(std::sync::atomic::Ordering::Relaxed), 1);
+                    assert!(std::fs::read_dir(&temp)?.next().is_none());
+                    assert!(!std::fs::read_dir(dir.path())?.any(|e| e
+                        .unwrap()
+                        .file_name()
+                        .to_string_lossy()
+                        .starts_with(".chopper-staging-")));
+                    assert_eq!(pool.usage().reserved_bytes, 0);
+                    println!(
+                        "PARALLEL_CSV_RUN_CONTROL {}",
+                        serde_json::json!({"pipeline":pipeline,"case":case,"parallel":parallel,"outcome":outcome,"input_visits":1,"cancel_batches":batches.load(std::sync::atomic::Ordering::Relaxed),"cleanup":true,"final_pool_reserved":0})
+                    );
+                }
+            }
+        }
+        Ok(())
+    }
+}
