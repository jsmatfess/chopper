+    fn collect(
+        parser: impl super::super::records::Records,
+        compact: bool,
+        ctx: &Context,
+    ) -> Result<(Vec<Vec<String>>, Option<String>, u64)> {
+        let mut memory = Reservation::new(ctx);
+        let mut parser = parser;
+        let mut fields = Vec::new();
+        let mut record = CompactRecord::default();
+        let mut rows = Vec::new();
+        let error = loop {
+            let result = if compact {
+                parser.next_compact_record_into_reserved(&mut record, &mut |n| memory.resize(n))
+            } else {
+                parser.next_record_into_reserved(&mut fields, &mut |n| memory.resize(n))
+            };
+            let held = if compact {
+                record.capacity()
+            } else {
+                fields.capacity() * std::mem::size_of::<String>()
+                    + fields.iter().map(String::capacity).sum::<usize>()
+            };
+            assert!(
+                memory.bytes() as usize >= held + parser.scratch_capacity(),
+                "target under-admitted"
+            );
+            if compact && result.is_err() {
+                assert!(record.is_empty());
+            }
+            match result {
+                Ok(true) => rows.push(if compact {
+                    record.fields().map(str::to_string).collect()
+                } else {
+                    fields.clone()
+                }),
+                Ok(false) => break None,
+                Err(error) => break Some(format!("{error:#}")),
+            }
+        };
+        let count = parser.record_number();
+        drop(record);
+        drop(fields);
+        drop(parser);
+        drop(memory);
+        Ok((rows, error, count))
+    }
+    fn parse(
+        data: &[u8],
+        capacity: usize,
+        maximum: usize,
+        batch: bool,
+        compact: bool,
+        ctx: &Context,
