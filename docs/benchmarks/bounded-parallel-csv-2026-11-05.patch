+//! Private bounded native ingestion study. No graph/operation changes.
+use super::*;
+use chopper_core::csv::CompactRecord;
+use std::io::{self, BufRead};
+
+const MAX_ROWS: usize = 1024;
+const TARGET_BYTES: usize = 128 * 1024;
+const MAX_WORKERS: usize = 4;
+
+enum Mode<R> {
+    Serial(Parser<R>),
+    Parallel { reader: R, batch: Batch },
+}
+pub(super) struct ParallelRecords<R> {
+    mode: Option<Mode<R>>,
+    ctx: Context,
+    maximum: usize,
+    record: u64,
+    header: bool,
+    eligible: bool,
+}
+impl<R: BufRead> ParallelRecords<R> {
+    pub(super) fn new(parser: Parser<R>, job: &Job, ctx: &Context, maximum: usize) -> Self {
+        let csv = &job.input_csv;
+        let eligible = ctx.workers() > 1
+            && csv.encoding == "utf-8"
+            && csv.delimiter == ','
+            && csv.quote == '"'
+            && csv.escape.is_none()
+            && !csv.skip_empty_lines
+            && csv.line_ending == "lf"
+            && job.zip_member.is_none()
+            && std::path::Path::new(&job.input)
+                .extension()
+                .is_some_and(|e| e == "csv");
+        #[cfg(test)]
+        let eligible = eligible && !tests::force_serial();
+        Self {
+            record: parser.record,
+            mode: Some(Mode::Serial(parser)),
+            ctx: ctx.clone(),
+            maximum,
+            header: csv.headers,
+            eligible,
+        }
+    }
+    fn prepare(&mut self) -> Result<()> {
+        if self.header {
+            self.header = false;
+            return Ok(());
+        }
+        if !self.eligible || !matches!(self.mode, Some(Mode::Serial(_))) {
+            return Ok(());
+        }
+        let Some(Mode::Serial(parser)) = self.mode.take() else {
+            unreachable!()
+        };
+        let batch = Batch::new(&self.ctx, self.maximum)?;
+        self.mode = Some(Mode::Parallel {
+            reader: parser.into_reader(),
+            batch,
+        });
+        Ok(())
+    }
+}
+impl<R: BufRead> super::records::Records for ParallelRecords<R> {
+    fn record_number(&self) -> u64 {
+        self.record
+    }
+    fn scratch_capacity(&self) -> usize {
+        match &self.mode {
+            Some(Mode::Serial(p)) => p.scratch_capacity(),
+            _ => 0,
+        }
+    }
+    fn next_record_into_reserved(
+        &mut self,
+        fields: &mut Vec<String>,
+        reserve: &mut impl FnMut(usize) -> Result<()>,
+    ) -> Result<bool> {
+        self.prepare()?;
+        match self.mode.as_mut().context("failed record source resumed")? {
+            Mode::Serial(parser) => {
+                let result = parser.next_record_into_reserved(fields, reserve);
+                self.record = parser.record;
+                result
+            }
+            Mode::Parallel { reader, batch } => {
+                let Some(row) = batch.next(reader, self.maximum, self.record)? else {
+                    fields.clear();
+                    reserve(fields.capacity() * std::mem::size_of::<String>())?;
+                    return Ok(false);
+                };
+                // Raw syntax/working limits were already enforced by the same
+                // strict Parser. Do not substitute the decoded-text limit.
+                chopper_core::csv::copy_text_fields_into_reserved(
+                    row.fields(),
+                    fields,
+                    usize::MAX,
+                    reserve,
+                )
+                .with_context(|| format!("CSV record {}", self.record + 1))?;
+                self.record += 1;
+                Ok(true)
+            }
+        }
+    }
+    fn next_compact_record_into_reserved(
+        &mut self,
+        fields: &mut CompactRecord,
+        reserve: &mut impl FnMut(usize) -> Result<()>,
+    ) -> Result<bool> {
+        let result = (|| -> Result<bool> {
+            self.prepare()?;
+            match self.mode.as_mut().context("failed record source resumed")? {
+                Mode::Serial(parser) => {
+                    let result = parser.next_compact_record_into_reserved(fields, reserve);
+                    self.record = parser.record;
+                    result
+                }
+                Mode::Parallel { reader, batch } => {
+                    let Some(row) = batch.next(reader, self.maximum, self.record)? else {
+                        fields.clear();
+                        reserve(fields.capacity())?;
+                        return Ok(false);
+                    };
+                    fields
+                        .set_text_fields_reserved(row.fields(), usize::MAX, reserve)
+                        .with_context(|| format!("CSV record {}", self.record + 1))?;
+                    self.record += 1;
+                    Ok(true)
+                }
+            }
+        })();
+        if result.is_err() {
+            fields.clear();
+        }
+        result
+    }
+}
+
+struct Worker {
+    // Drop every record and its descriptor allocation before either grant.
+    rows: Vec<CompactRecord>,
+    error: Option<anyhow::Error>,
+    terminal: Option<io::Error>,
+    start: usize,
+    end: usize,
+    base: u64,
+    assigned: usize,
+    complete: usize,
+    data: Reservation,
+    metadata: Reservation,
+}
+impl Worker {
+    fn new(ctx: &Context, count: usize) -> Result<Self> {
+        let mut metadata = Reservation::new(ctx);
+        let mut rows = Vec::new();
+        metadata.reserve_vec(&mut rows, count)?;
+        rows.resize_with(count, CompactRecord::default);
+        Ok(Self {
+            rows,
+            error: None,
+            terminal: None,
+            start: 0,
+            end: 0,
+            base: 0,
+            assigned: 0,
+            complete: 0,
+            data: Reservation::new(ctx),
+            metadata,
+        })
+    }
+    fn clear(&mut self) -> Result<()> {
+        for row in &mut self.rows {
+            *row = CompactRecord::default();
+        }
+        self.error = None;
+        self.terminal = None;
+        self.complete = 0;
+        self.assigned = 0;
+        self.data.resize(0)
+    }
+    fn parse(&mut self, raw: &[u8], maximum: usize) {
+        // Default UTF-8/LF settings have two known small String allocations;
+        // their bytes remain pre-admitted in the Source metadata grant.
+        let reader = Prefix {
+            bytes: &raw[self.start..self.end],
+            terminal: self.terminal.take(),
+        };
+        let mut parser = Parser::new(reader, chopper_core::CsvSettings::default(), maximum);
+        parser.record = self.base;
+        let mut retained = 0;
+        for index in 0..self.assigned {
+            match parser.next_compact_record_into_reserved(&mut self.rows[index], &mut |n| {
+                self.data.resize(retained + n)
+            }) {
+                Ok(true) => {
+                    self.complete += 1;
+                    retained += self.rows[index].capacity();
+                }
+                Ok(false) => {
+                    self.error = Some(anyhow::anyhow!("framed record disappeared"));
+                    break;
+                }
+                Err(error) => {
+                    self.error = Some(error);
+                    break;
+                }
+            }
+        }
+        if self.error.is_none() {
+            // Only the last worker can carry a deferred source error. Reading
+            // beyond its final complete record preserves the serial context.
+            let mut extra = CompactRecord::default();
+            match parser.next_compact_record_into_reserved(&mut extra, &mut |n| {
+                self.data.resize(retained + n)
+            }) {
+                Ok(false) => {}
+                Ok(true) => self.error = Some(anyhow::anyhow!("framing omitted a record")),
+                Err(error) => self.error = Some(error),
+            }
+            drop(extra);
+        }
+        // Parser scratch is covered along with all retained rows until drop.
+        drop(parser);
+        let held = self.rows.iter().map(CompactRecord::capacity).sum();
+        if let Err(error) = self.data.resize(held) {
+            self.error = Some(error);
+        }
+    }
+}
+
+struct Prefix<'a> {
+    bytes: &'a [u8],
+    terminal: Option<io::Error>,
+}
+impl io::Read for Prefix<'_> {
+    fn read(&mut self, out: &mut [u8]) -> io::Result<usize> {
+        let bytes = self.fill_buf()?;
+        let n = bytes.len().min(out.len());
+        out[..n].copy_from_slice(&bytes[..n]);
+        self.consume(n);
+        Ok(n)
+    }
+}
+impl BufRead for Prefix<'_> {
+    fn fill_buf(&mut self) -> io::Result<&[u8]> {
+        if self.bytes.is_empty() {
+            if let Some(error) = self.terminal.take() {
+                return Err(error);
+            }
+        }
+        Ok(self.bytes)
+    }
+    fn consume(&mut self, n: usize) {
+        self.bytes = &self.bytes[n..];
+    }
+}
+
+struct Batch {
+    workers: Vec<Worker>,
+    raw: Vec<u8>,
+    ends: Vec<usize>,
+    ctx: Context,
+    maximum: usize,
+    raw_limit: usize,
+    next_worker: usize,
+    next_row: usize,
+    active: usize,
+    finished: bool,
+    batches: usize,
+    delivered: usize,
+    peak_grants: u64,
+    raw_grant: Reservation,
+    metadata: Reservation,
+}
+impl Batch {
+    fn new(ctx: &Context, maximum: usize) -> Result<Self> {
+        let raw_limit = TARGET_BYTES
+            .checked_add(maximum)
+            .and_then(|n| n.checked_add(2))
+            .context("raw framing bound overflow")?;
+        let count = ctx.workers().min(MAX_WORKERS);
+        let mut metadata = Reservation::new(ctx);
+        // CsvSettings::default creates known 5+2 byte strings per worker.
+        metadata.resize(count * 16)?;
+        let mut workers = Vec::new();
+        metadata.reserve_vec(&mut workers, count)?;
+        let rows = MAX_ROWS.div_ceil(count);
+        for _ in 0..count {
+            workers.push(Worker::new(ctx, rows)?);
+        }
+        let mut ends = Vec::new();
+        metadata.reserve_vec(&mut ends, MAX_ROWS)?;
+        let mut raw_grant = Reservation::new(ctx);
+        let mut raw = Vec::new();
+        raw_grant.reserve_vec(&mut raw, raw_limit)?;
+        Ok(Self {
+            workers,
+            raw,
+            ends,
+            ctx: ctx.clone(),
+            maximum,
+            raw_limit,
+            next_worker: 0,
+            next_row: 0,
+            active: 0,
+            finished: false,
+            batches: 0,
+            delivered: 0,
+            peak_grants: 0,
+            raw_grant,
+            metadata,
+        })
+    }
+    fn fill(&mut self, reader: &mut dyn BufRead, base: u64) -> Result<()> {
+        for worker in &mut self.workers {
+            worker.clear()?;
+        }
+        self.raw.clear();
+        self.ends.clear();
+        self.next_worker = 0;
+        self.next_row = 0;
+        self.active = 0;
+        let mut quoted = false;
+        let mut terminal = None;
+        loop {
+            if let Err(error) = self.ctx.check() {
+                terminal = Some(io::Error::other(error));
+                self.finished = true;
+                break;
+            }
+            let data = match reader.fill_buf() {
+                Ok(data) => data,
+                Err(error) => {
+                    terminal = Some(error);
+                    self.finished = true;
+                    break;
+                }
+            };
+            if data.is_empty() {
+                self.finished = true;
+                break;
+            }
+            let available = data.len().min(self.raw_limit - self.raw.len());
+            let mut take = available;
+            let mut stop = false;
+            for offset in chopper_core::csv::study_framing_positions(&data[..available]) {
+                if data[offset] == b'"' {
+                    quoted = !quoted;
+                } else if !quoted {
+                    let end = self.raw.len() + offset + 1;
+                    self.ends.push(end);
+                    if self.ends.len() == MAX_ROWS || end >= TARGET_BYTES {
+                        take = offset + 1;
+                        stop = true;
+                        break;
+                    }
+                }
+            }
+            self.raw.extend_from_slice(&data[..take]);
+            reader.consume(take);
+            if stop {
+                break;
+            }
+            if self.raw.len() == self.raw_limit {
+                // A bounded prefix already exceeds the strict raw working
+                // limit. The strict parser chooses its earlier error, if any.
+                self.finished = true;
+                break;
+            }
+        }
+        if !self.raw.is_empty() && self.ends.last().copied() != Some(self.raw.len()) {
+            self.ends.push(self.raw.len());
+        }
+        if self.ends.is_empty() && terminal.is_none() {
+            return Ok(());
+        }
+        let count = self.workers.len();
+        let per = self.ends.len().div_ceil(count).max(1);
+        let mut first = 0;
+        let mut start = 0;
+        for worker in &mut self.workers {
+            if first >= self.ends.len() {
+                break;
+            }
+            let end_row = (first + per).min(self.ends.len());
+            worker.start = start;
+            worker.end = self.ends[end_row - 1];
+            worker.base = base + first as u64;
+            worker.assigned = end_row - first;
+            start = worker.end;
+            first = end_row;
+            self.active += 1;
+        }
+        if self.active == 0 {
+            self.active = 1;
+            let w = &mut self.workers[0];
+            w.start = 0;
+            w.end = 0;
+            w.base = base;
+        }
+        self.workers[self.active - 1].terminal = terminal;
+        let raw = &self.raw;
+        let maximum = self.maximum;
+        self.ctx
+            .for_each_batch(&mut self.workers[..self.active], |worker| {
+                worker.parse(raw, maximum)
+            });
+        self.batches += 1;
+        #[cfg(test)]
+        tests::after_batch();
+        let grant = self.raw_grant.bytes()
+            + self.metadata.bytes()
+            + self
+                .workers
+                .iter()
+                .map(|w| w.data.bytes() + w.metadata.bytes())
+                .sum::<u64>();
+        self.peak_grants = self.peak_grants.max(grant);
+        Ok(())
+    }
+}
+impl Batch {
+    fn next<'a>(
+        &'a mut self,
+        reader: &mut dyn BufRead,
+        maximum: usize,
+        record: u64,
+    ) -> Result<Option<&'a CompactRecord>> {
+        ensure!(maximum == self.maximum, "parser maximum changed");
+        loop {
+            if self.next_worker < self.active {
+                let index_worker = self.next_worker;
+                if self.next_row < self.workers[index_worker].complete {
+                    let index = self.next_row;
+                    self.next_row += 1;
+                    self.delivered += 1;
+                    return Ok(Some(&self.workers[self.next_worker].rows[index]));
+                }
+                if let Some(error) = self.workers[index_worker].error.take() {
+                    return Err(error);
+                }
+                self.next_worker += 1;
+                self.next_row = 0;
+                continue;
+            }
+            if self.finished {
+                return Ok(None);
+            }
+            self.fill(reader, record)?;
+        }
+    }
+}
+impl Drop for Batch {
+    fn drop(&mut self) {
+        eprintln!(
+            "PARALLEL_CSV batches={} rows={} workers={} peak_owned_grants={} raw_capacity={}",
+            self.batches,
+            self.delivered,
+            self.workers.len(),
+            self.peak_grants,
+            self.raw.capacity()
+        );
+    }
+}
