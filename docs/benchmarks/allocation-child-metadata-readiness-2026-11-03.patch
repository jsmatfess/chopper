+    #[test]
+    fn parent_retry_metadata_partial_denial_and_empty_children() -> Result<()> {
+        const LIMIT: u64 = 8 * 1024 * 1024;
+        for mode in ["partial", "success", "cancel"] {
+            let pressured = mode == "partial";
+            let pool = Arc::new(crate::resources::MemoryPool::new(LIMIT));
+            let cancel = Arc::new(AtomicBool::new(false));
+            let mut ctx = Context::new(
+                &Resources {
+                    workers: 1,
+                    ..Default::default()
+                },
+                cancel.clone(),
+                Arc::new(|_| {}),
+            )?;
+            ctx.memory = 16 * 1024 * 1024;
+            ctx.replace_workspace_for_test(Workspace::shared(ctx.memory, pool.clone()))?;
+            let operation = Operation::AssignProbabilistic {
+                groups: (0..16)
+                    .map(|i| Allocation {
+                        name: format!("group-{i:02}"),
+                        percent: if i == 0 { "100".into() } else { "0".into() },
+                    })
+                    .collect(),
+                strata: vec![],
+            };
+            let parent = Group {
+                offset: 0,
+                rows: 32,
+                lineage: vec![],
+                exact: false,
+            };
+            let mut state = StreamingGroups {
+                sorter: Sorter::new(&ctx, SortOrder::Key),
+                membership: Membership::new(&operation, None, 3, [7; 32], &ctx)?,
+            };
+            for id in 0..32 {
+                state.push(Row {
+                    id,
+                    ordinal: id,
+                    key: vec![],
+                    fields: vec![id.to_string(), "payload".into(), "x".into()],
+                })?;
+            }
+            let mut ready = state.finish()?;
+            assert!(matches!(ready.rows, SortedRows::Memory(_)));
+            let mut sink = DatasetWriter::new(&ctx)?;
+            let mut competitor = Reservation::for_workspace(Arc::new(Workspace::shared(
+                LIMIT as usize,
+                pool.clone(),
+            )));
+            let mut expected_partial = 0;
+            if pressured {
+                let before = pool.usage().reserved_bytes;
+                let first = group_metadata::ClonedGroup::child(
+                    &parent,
+                    &ready.membership.entry(0, 0),
+                    &ctx,
+                    |lineage| Group {
+                        offset: 0,
+                        rows: 0,
+                        lineage,
+                        exact: false,
+                    },
+                )?;
+                let first_bytes = pool.usage().reserved_bytes - before;
+                drop(first);
+                let descriptor_bytes = 16 * std::mem::size_of::<group_metadata::ClonedGroup>();
+                competitor.resize(
+                    (LIMIT - before - first_bytes - descriptor_bytes as u64 - 256) as usize,
+                )?;
+                expected_partial = pool.usage().reserved_bytes;
+            }
+            CHILD_PREPARED.with(|n| n.set(0));
+            let result = ready.prepare_children(&parent, 0, &ctx);
+            let built = CHILD_PREPARED.with(|n| n.get());
+            if pressured {
+                assert!(matches!(
+                    result
+                        .err()
+                        .and_then(|e| e.downcast::<crate::resources::MemoryAdmission>().ok()),
+                    Some(crate::resources::MemoryAdmission::Shared { .. })
+                ));
+                assert!(
+                    built > 0 && built < 16,
+                    "must deny after partial construction: {built}"
+                );
+                assert!(ready.children.is_none());
+                assert_eq!(
+                    pool.usage().reserved_bytes,
+                    expected_partial,
+                    "partial child owners and vector grant must release"
+                );
+            } else {
+                result?;
+                assert_eq!(built, 16);
+                if mode == "cancel" {
+                    cancel.store(true, std::sync::atomic::Ordering::Relaxed);
+                    let error = ready
