+    fn prepare_children(&mut self, parent: &Group, step: usize, ctx: &Context) -> Result<()> {
+        // Only resident iteration transfers already-admitted row capacity. Disk
+        // cursors can admit new reads later and need a separate feasibility design.
+        if !matches!(self.rows, SortedRows::Memory(_)) {
+            return Ok(());
+        }
+        let mut memory = Reservation::new(ctx);
+        let mut children = Vec::new();
+        memory.reserve_vec(&mut children, self.membership.counts().len())?;
+        for index in 0..self.membership.counts().len() {
+            ctx.check()?;
+            children.push(group_metadata::ClonedGroup::child(
+                parent,
+                &self.membership.entry(step, index),
+                ctx,
+                |lineage| Group {
+                    offset: 0,
+                    rows: 0,
+                    lineage,
+                    exact: self.membership.exact(),
+                },
+            )?);
+            #[cfg(test)]
+            CHILD_PREPARED.with(|n| n.set(n.get() + 1));
+        }
+        self.children = Some(ReadyChildren {
+            children: children.into_iter(),
+            _memory: memory,
+        });
+        Ok(())
+    }
