+#[test]
+fn probabilistic_shuffle_live_owner_control() -> Result<()> {
+    let mut reference = None;
+    for candidate in [false, true] {
+        ENABLED.set(candidate);
+        let (dir, mut job) = setup(20000)?;
+        let mut text = String::from("id,region,payload\n");
+        for id in 0..20000 {
+            text.push_str(&format!("{id},R0,{}\n", payload(id)));
+        }
+        fs::write(&job.input, text)?;
+        if let Operation::AssignProbabilistic { groups, .. } = &mut job.operations[1] {
+            groups[0].percent = "50".into();
+            groups[1].percent = "50".into();
+        }
+        let pool = Arc::new(crate::resources::MemoryPool::new(32 * 1024 * 1024));
+        let space = Arc::new(crate::storage::Workspace::shared(
+            32 * 1024 * 1024,
+            pool.clone(),
+        ));
+        let grant = Arc::new(std::sync::Mutex::new(Reservation::for_workspace(space)));
+        let g = grant.clone();
+        let shared = pool.clone();
+        let injection = Arc::new(std::sync::Mutex::new(None));
+        let event = injection.clone();
+        let visits = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+        let seen = visits.clone();
+        let result=prepare_with_memory_pool(job.clone(),Arc::new(AtomicBool::new(false)),Arc::new(move|p|{
+            if p.phase=="Reading and validating CSV"&&p.rows==0{seen.fetch_add(1,Ordering::Relaxed);}
+            if p.phase=="Preparing operation 2 of 3"{assert!(event.lock().unwrap().is_none());g.lock().unwrap().resize(28*1024*1024).unwrap();*event.lock().unwrap()=Some(serde_json::json!({"phase":p.phase.as_str(),"rows":p.rows,"pool_reserved":shared.usage().reserved_bytes,"grant_bytes":28*1024*1024}));}
+        }),pool.clone()).and_then(|p|{
+            let ctx=p.ctx.clone();let a=p.execute()?;let diagnostics=ctx.diagnostics();let checked=verify_live_owner(dir.path(),&job,20000,&a)?;
+            if let Some(ref old)=reference{assert_eq!(&checked,old);}else{reference=Some(checked);}
+            drop(a);drop(ctx);Ok(diagnostics)
+        });
+        let (outcome, diagnostics) = match result {
+            Ok(d) => ("success_exact", d),
+            Err(e) => {
+                assert!(
+                    matches!(
+                        e.downcast_ref::<crate::resources::MemoryAdmission>(),
+                        Some(crate::resources::MemoryAdmission::Shared { .. })
+                            | Some(crate::resources::MemoryAdmission::Local)
+                    ),
+                    "{e:#}"
+                );
+                assert!(!std::path::Path::new(&job.output).exists());
+                (
+                    "typed_memory_denial",
+                    serde_json::json!({"error":format!("{e:#}")}),
+                )
+            }
+        };
+        assert!(injection.lock().unwrap().is_some());
+        assert_eq!(visits.load(Ordering::Relaxed), 1);
+        assert_eq!(fs::read_dir(dir.path().join("temp"))?.count(), 0);
+        assert!(!fs::read_dir(dir.path())?.any(|e| e
+            .unwrap()
+            .file_name()
+            .to_string_lossy()
+            .starts_with(".chopper-staging-")));
+        assert_eq!(pool.usage().reserved_bytes, 28 * 1024 * 1024);
+        grant.lock().unwrap().resize(0)?;
+        assert_eq!(pool.usage().reserved_bytes, 0);
+        println!(
+            "PROB_LIVE_OWNER {}",
+            serde_json::json!({"candidate":candidate,"outcome":outcome,"diagnostics":diagnostics,"injection":*injection.lock().unwrap(),"input_visits":1,"cleanup":true,"final_pool_reserved":0})
+        );
+    }
+    ENABLED.set(false);
+    Ok(())
+}
