+
+fn verify_live_owner(
+    dir: &std::path::Path,
+    job: &Job,
+    n: usize,
+    a: &Analysis,
+) -> Result<serde_json::Value> {
+    let mut files = BTreeMap::new();
+    let mut records = Vec::new();
+    let mut ids = BTreeSet::new();
+    for entry in fs::read_dir(&job.output)? {
+        let e = entry?;
+        let name = e.file_name().to_string_lossy().into_owned();
+        let bytes = fs::read(e.path())?;
+        if name.ends_with(".csv") {
+            assert!(bytes.len() <= 65536);
+            let text = std::str::from_utf8(&bytes)?;
+            let mut lines = text.lines();
+            assert_eq!(lines.next(), Some("id,region,payload"));
+            let mut count = 0;
+            for line in lines {
+                let fields: Vec<_> = line.split(',').collect();
+                assert_eq!(fields.len(), 3);
+                let id = fields[0].parse::<usize>()?;
+                assert!(id < n && ids.insert(id));
+                assert_eq!(fields[1], "R0");
+                assert_eq!(fields[2], payload(id));
+                count += 1;
+            }
+            assert!(count <= 1024);
+            files.insert(name, bytes);
+        } else {
+            assert_eq!(name, "manifest.jsonl");
+            for line in bytes.split(|b| *b == b'\n').filter(|l| !l.is_empty()) {
+                let v: serde_json::Value = serde_json::from_slice(line)?;
+                if v["type"] == "output" {
+                    records.push(v);
+                }
+            }
+        }
+    }
+    assert_eq!(ids, (0..n).collect());
+    assert_eq!(a.rows, n as u64);
+    assert_eq!(a.groups, 3);
+    assert_eq!(files.len() as u64, a.output_files);
+    assert!(!fs::read_dir(dir)?.any(|e| e
+        .unwrap()
+        .file_name()
+        .to_string_lossy()
+        .starts_with(".chopper-staging-")));
+    let analysis = serde_json::to_value(a)?;
+    let logical: serde_json::Map<String, serde_json::Value> = [
+        "algorithm_version",
+        "column_values",
+        "seed",
+        "rows",
+        "columns",
+        "header",
+        "preview",
+        "logical_digest",
+        "groups",
+        "output_files",
+        "output_csv_bytes",
+        "largest_record_bytes",
+        "memory_budget_bytes",
+        "workers",
+        "stages",
+        "warnings",
+        "accuracy",
+    ]
+    .into_iter()
+    .map(|k| (k.into(), analysis[k].clone()))
+    .collect();
+    Ok(serde_json::json!({"files":files,"outputs":records,"analysis":logical}))
+}
