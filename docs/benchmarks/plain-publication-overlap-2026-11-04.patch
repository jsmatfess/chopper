+#[test]
+fn plain_publication_parallel_safety() -> Result<()> {
+    for parallel in [false, true] {
+        crate::output::research_publication::set(parallel);
+        let (dir, mut job) = setup(2000)?;
+        job.operations.clear();
+        job.resources.memory_mb = 128.into();
+        job.resources.workers = 4;
+        let cancel = Arc::new(AtomicBool::new(false));
+        let set = cancel.clone();
+        let fired = Arc::new(AtomicBool::new(false));
+        let event = fired.clone();
+        let pool = Arc::new(crate::resources::MemoryPool::new(128 * 1024 * 1024));
+        let p = prepare_with_memory_pool(
+            job.clone(),
+            cancel,
+            Arc::new(move |p| {
+                if p.phase == "Writing output" && p.rows > 0 {
+                    event.store(true, Ordering::Relaxed);
+                    set.store(true, Ordering::Relaxed);
+                }
+            }),
+            pool.clone(),
+        )?;
+        assert_eq!(p.analysis.workers, 4);
+        let e = p.execute().expect_err("cancel after a collected chunk");
+        assert!(format!("{e:#}").contains("job cancelled"));
+        assert!(fired.load(Ordering::Relaxed));
+        assert!(!std::path::Path::new(&job.output).exists());
+        assert_eq!(fs::read_dir(dir.path().join("temp"))?.count(), 0);
+        assert_eq!(fs::read_dir(dir.path())?.count(), 2);
+        assert_eq!(pool.usage().reserved_bytes, 0);
+        println!(
+            "PLAIN_PARALLEL_SAFETY {}",
+            serde_json::json!({"parallel":parallel,"case":"mid_publication_cancel","outcome":"cancelled","cleanup":true,"peak_active_chunks":crate::output::research_publication::peak()})
+        );
+    }
+    let mut reference = None;
+    for parallel in [false, true] {
+        crate::output::research_publication::set(parallel);
+        let (dir, mut job) = setup(2000)?;
+        job.operations.clear();
+        job.resources.memory_mb = 128.into();
+        job.resources.workers = 4;
+        let pool = Arc::new(crate::resources::MemoryPool::new(128 * 1024 * 1024));
+        let space = Arc::new(crate::storage::Workspace::shared(
+            128 * 1024 * 1024,
+            pool.clone(),
+        ));
+        let grant = Arc::new(std::sync::Mutex::new(Reservation::for_workspace(space)));
+        let g = grant.clone();
+        let shared = pool.clone();
+        let held = Arc::new(std::sync::atomic::AtomicU64::new(0));
+        let bytes = held.clone();
+        let result = prepare_with_memory_pool(
+            job.clone(),
+            Arc::new(AtomicBool::new(false)),
+            Arc::new(move |p| {
+                if p.phase == "Ready for confirmation" {
+                    let amount = (128 * 1024 * 1024u64)
+                        .saturating_sub(shared.usage().reserved_bytes)
+                        .saturating_sub(200 * 1024);
+                    assert!(amount > 0);
+                    g.lock()
+                        .unwrap()
+                        .resize(usize::try_from(amount).unwrap())
+                        .unwrap();
+                    bytes.store(amount, Ordering::Relaxed);
+                }
+            }),
+            pool.clone(),
+        )
+        .and_then(|p| {
+            let ctx = p.ctx.clone();
+            let a = p.execute()?;
+            let checked = verify(dir.path(), &job, 2000, &a)?;
+            if let Some(ref old) = reference {
+                assert_eq!(&checked, old);
+            } else {
+                reference = Some(checked);
+            }
+            drop(a);
+            drop(ctx);
+            Ok(())
+        });
+        let outcome = match result {
+            Ok(()) => "success_exact",
+            Err(e) => {
+                assert!(
+                    matches!(
+                        e.downcast_ref::<crate::resources::MemoryAdmission>(),
+                        Some(crate::resources::MemoryAdmission::Shared { .. })
+                            | Some(crate::resources::MemoryAdmission::Local)
+                    ),
+                    "{e:#}"
+                );
+                assert!(!std::path::Path::new(&job.output).exists());
+                "typed_memory_denial"
+            }
+        };
+        assert_eq!(fs::read_dir(dir.path().join("temp"))?.count(), 0);
+        assert!(!fs::read_dir(dir.path())?.any(|e| e
+            .unwrap()
+            .file_name()
+            .to_string_lossy()
+            .starts_with(".chopper-staging-")));
+        assert_eq!(pool.usage().reserved_bytes, held.load(Ordering::Relaxed));
+        drop(grant);
+        assert_eq!(pool.usage().reserved_bytes, 0);
+        println!(
+            "PLAIN_PARALLEL_SAFETY {}",
+            serde_json::json!({"parallel":parallel,"case":"late_200KiB_free","outcome":outcome,"grant_bytes":held.load(Ordering::Relaxed),"cleanup":true,"peak_active_chunks":crate::output::research_publication::peak()})
+        );
+    }
+    crate::output::research_publication::set(false);
+    Ok(())
+}
