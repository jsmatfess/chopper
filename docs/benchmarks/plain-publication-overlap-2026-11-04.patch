+#[test]
+fn plain_publication_parallel_panel() -> Result<()> {
+    let mut reference = None;
+    let mut last_recipe = None;
+    for (rep, (fusion_recipe, parallel)) in [
+        (false, false),
+        (false, true),
+        (false, true),
+        (false, false),
+        (true, false),
+        (true, true),
+        (true, true),
+        (true, false),
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        ENABLED.set(true);
+        crate::output::research_publication::set(parallel);
+        if last_recipe != Some(fusion_recipe) {
+            reference = None;
+        }
+        last_recipe = Some(fusion_recipe);
+        let (dir, mut job) = setup(200000)?;
+        if !fusion_recipe {
+            job.operations.clear();
+        }
+        job.resources.memory_mb = 128.into();
+        job.resources.workers = 4;
+        let input_hash = blake3::hash(&fs::read(&job.input)?).to_hex().to_string();
+        let pool = Arc::new(crate::resources::MemoryPool::new(128 * 1024 * 1024));
+        let started = std::time::Instant::now();
+        let prepared = prepare_with_memory_pool(
+            job.clone(),
+            Arc::new(AtomicBool::new(false)),
+            Arc::new(|_| {}),
+            pool.clone(),
+        )?;
+        let preparation_seconds = started.elapsed().as_secs_f64();
+        let execution_started = std::time::Instant::now();
+        let ctx = prepared.ctx.clone();
+        let a = prepared.execute()?;
+        let execution_seconds = execution_started.elapsed().as_secs_f64();
+        let seconds = started.elapsed().as_secs_f64();
+        assert_eq!(a.workers, 4);
+        let diagnostics = ctx.diagnostics();
+        let checked = verify(dir.path(), &job, 200000, &a)?;
+        if let Some(ref old) = reference {
+            assert_eq!(&checked, old);
+        } else {
+            reference = Some(checked);
+        }
+        let peak = crate::output::research_publication::peak();
+        assert!((1..=4).contains(&peak));
+        if !parallel {
+            assert_eq!(peak, 1);
+        }
+        drop(a);
+        drop(ctx);
+        assert_eq!(fs::read_dir(dir.path().join("temp"))?.count(), 0);
+        assert_eq!(pool.usage().reserved_bytes, 0);
+        println!(
+            "PLAIN_PARALLEL {}",
+            serde_json::json!({"rep":rep,"fusion_recipe":fusion_recipe,"parallel":parallel,"rows":200000,"workers":4,"memory_mb":128,"input_blake3":input_hash,"seconds":seconds,"preparation_seconds":preparation_seconds,"execution_seconds":execution_seconds,"peak_active_chunks":peak,"diagnostics":diagnostics,"exact_output_verified":true,"cleanup":true})
+        );
+    }
+    ENABLED.set(false);
+    crate::output::research_publication::set(false);
+    Ok(())
