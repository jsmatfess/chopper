+#[test]
+fn probabilistic_shuffle_available_buffer_contract() -> Result<()> {
+    use crate::storage::Workspace;
+    let pool = Arc::new(crate::resources::MemoryPool::new(1024));
+    let own = Arc::new(Workspace::shared(768, pool.clone()));
+    let peer = Arc::new(Workspace::shared(1024, pool.clone()));
+    let mut a = Reservation::for_workspace(own.clone());
+    let mut b = Reservation::for_workspace(peer);
+    a.resize(64)?;
+    b.resize(400)?;
+    assert_eq!(own.available_sort_buffer_limit(999), 280);
+    assert_eq!(own.available_sort_buffer_limit(100), 100);
+    assert_eq!(pool.usage().reserved_bytes, 464, "target is not a grant");
+    b.resize(800)?;
+    assert_eq!(own.available_sort_buffer_limit(999), 80);
+    drop(a);
+    drop(b);
+    assert_eq!(pool.usage().reserved_bytes, 0);
+    println!("AVAILABLE_BUFFER_CONTRACT passed");
+    Ok(())
+}
+
+#[test]
+fn probabilistic_shuffle_available_buffer_fitting() -> Result<()> {
+    probabilistic_shuffle_available_buffer_contract()?;
+    panel(
+        "available-buffer-fitting",
+        20000,
+        vec![false, true],
+        Grouping::Auto,
+    )
+}
