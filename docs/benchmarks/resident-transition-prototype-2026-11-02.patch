+    /// Prepare every known allocation key. Empty files and their owned grants
+    /// survive retention; overflow only writes to existing admitted writers.
+    pub(super) fn prepare_indices(ctx: &Context, groups: usize) -> Result<Option<Self>> {
+        let mut router = Self::new(ctx);
+        for index in 0..groups {
+            if !router.push_parts(&(index as u64).to_be_bytes(), 0, |_| Ok(()))? {
+                return Ok(None);
+            }
+        }
+        Ok(Some(router))
