+        // This observation is only a target; every allocation still admits.
+        let remaining = ctx.workspace.remaining();
+        sorter.buffer_limit = sorter.buffer_limit.min(remaining / 2);
+        sorter.routing_candidate = false;
+        sorter.prepared_router = Some(router);
+        Ok(sorter)
