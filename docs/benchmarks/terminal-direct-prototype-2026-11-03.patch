+#[test]
+fn terminal_direct_parity_caps_names_empty_and_encoding() -> Result<()> {
+    for (headers, encoding, bom) in [
+        (true, "utf-8", false),
+        (false, "utf-8", false),
+        (true, "utf-16le", true),
+    ] {
+        let input = if headers {
+            "id,kind,text\n1,A,\"comma,quote\"\"\"\n2,A,\"line\nbreak\"\n3,B,界\n4,B,\n"
+        } else {
+            "1,A,x\n2,A,y\n3,B,z\n4,B,\n"
+        };
+        let (_dir, mut job) = setup(input.as_bytes())?;
+        terminal_recipe(&mut job);
+        job.input_csv.headers = headers;
+        job.output_csv.headers = headers;
+        job.output_csv.encoding = encoding.into();
+        job.output_csv.bom = bom;
+        job.limits.rows = Some(1);
+        job.limits.bytes = Some(128);
+        let result = parity(job.clone())?;
+        assert_eq!(result.rows, 4);
+        assert_eq!(result.groups, 4);
+        let records = manifest(&job.output)?;
+        assert_eq!(
+            records
+                .iter()
+                .filter(|r| r["type"] == "output" && r["rows"] == 0)
+                .count(),
+            2
+        );
+        for record in records.iter().skip(1) {
+            let name = record["path"].as_str().unwrap();
+            assert!(
+                name.starts_with(if headers { "kind-" } else { "column-2-" }),
+                "{name}"
+            );
+            assert!(record["csv_bytes"].as_u64().unwrap() <= 128);
+        }
+    }
+    // Empty source and header-only sources retain existing empty-output rules.
+    for data in [b"id,kind,text\n".as_slice(), b"".as_slice()] {
+        let (_dir, mut job) = setup(data)?;
+        terminal_recipe(&mut job);
+        if data.is_empty() {
+            job.input_csv.headers = false;
+            job.output_csv.headers = false;
+        }
+        // A completely empty source cannot resolve column1: both paths must fail safely.
+        if data.is_empty() {
+            assert!(run(job).is_err());
+        } else {
+            parity(job)?;
+        }
+    }
+    Ok(())
+}
