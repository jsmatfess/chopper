+#[test]
+fn terminal_direct_late_failure_cancel_and_destination_race_cleanup() -> Result<()> {
+    for mode in ["encoding", "files", "cancel-final", "race"] {
+        let (dir, mut job) = setup("id,kind,text\n1,A,first\n2,A,界\n3,B,last\n".as_bytes())?;
+        terminal_recipe(&mut job);
+        job.limits.rows = Some(1);
+        if mode == "encoding" {
+            job.output_csv.encoding = "windows-1252".into();
+        }
+        if mode == "files" {
+            job.resources.max_files = 3;
+        }
+        let signal = Arc::new(AtomicBool::new(false));
+        let cancel = signal.clone();
+        let output = job.output.clone();
+        let result = engine::run(
+            job.clone(),
+            signal,
+            Arc::new(move |progress| {
+                if progress.phase == "Finalizing direct terminal output" {
+                    if mode == "cancel-final" {
+                        cancel.store(true, Ordering::Relaxed);
+                    }
+                    if mode == "race" {
+                        fs::create_dir(&output).unwrap();
+                        fs::write(Path::new(&output).join("other"), b"preserve").unwrap();
+                    }
+                }
+            }),
+        );
+        assert!(result.is_err(), "{mode} must fail");
+        if mode == "race" {
+            assert_eq!(fs::read(Path::new(&job.output).join("other"))?, b"preserve");
+            assert_eq!(fs::read_dir(&job.output)?.count(), 1);
+            fs::remove_dir_all(&job.output)?;
+        }
+        clean(dir.path(), &job)?;
+    }
+    Ok(())
+}
