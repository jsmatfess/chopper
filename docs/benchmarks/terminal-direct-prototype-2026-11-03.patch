+// Isolated experiment only: no production selector or schema change.
+fn terminal_direct_eligible(job: &Job) -> bool {
+    job.full_shuffle_policy.is_seeded()
+        && job.compression == chopper_core::Compression::None
+        && job.resources.workers == 1
+        && matches!(
+            job.operations.as_slice(),
+            [
+                Operation::Partition { .. },
+                Operation::AssignProbabilistic { .. }
+            ]
+        )
+}
