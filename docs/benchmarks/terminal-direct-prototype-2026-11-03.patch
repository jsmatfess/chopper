+use super::*;
+use crate::resources::MemoryPool;
+use std::{fs, path::Path, sync::atomic::Ordering};
+
+fn setup(input: &[u8]) -> Result<(tempfile::TempDir, Job)> {
+    let dir = tempfile::tempdir()?;
+    fs::write(dir.path().join("input.csv"), input)?;
+    fs::create_dir(dir.path().join("temp"))?;
+    let mut job = Job {
+        input: dir.path().join("input.csv").to_string_lossy().into(),
+        output: dir.path().join("output").to_string_lossy().into(),
+        seed: Some("terminal-test".into()),
+        resources: Resources {
+            memory_mb: 32.into(),
+            workers: 1,
+            max_record_bytes: 1048576,
+            temp_dir: Some(dir.path().join("temp").to_string_lossy().into()),
+            ..Default::default()
+        },
+        ..Default::default()
+    };
+    terminal_recipe(&mut job);
+    Ok((dir, job))
+}
+fn terminal_recipe(job: &mut Job) {
+    job.operations = vec![
+        Operation::Partition {
+            columns: vec![Column::Index(1)],
+        },
+        Operation::AssignProbabilistic {
+            groups: vec![
+                Allocation {
+                    name: "all".into(),
+                    percent: "100".into(),
+                },
+                Allocation {
+                    name: "empty".into(),
+                    percent: "0".into(),
+                },
+            ],
+            strata: vec![],
+        },
+    ];
+}
+fn clean(dir: &Path, job: &Job) -> Result<()> {
+    assert!(!Path::new(&job.output).exists());
+    assert_eq!(fs::read_dir(dir.join("temp"))?.count(), 0);
+    assert!(!fs::read_dir(dir)?.any(|e| e
+        .unwrap()
+        .file_name()
+        .to_string_lossy()
+        .starts_with(".chopper-staging-")));
+    Ok(())
+}
+#[test]
+fn terminal_direct_post_emission_shared_denial_never_replays() -> Result<()> {
+    use std::sync::{atomic::AtomicUsize, Mutex};
+    for phase in ["Serializing output", "Finalizing direct terminal output"] {
+        let text = format!("id,kind,text\n{}", "1,A,x\n".repeat(65537));
+        let (dir, mut job) = setup(text.as_bytes())?;
+        terminal_recipe(&mut job);
+        let pool = Arc::new(MemoryPool::new(64 * 1024 * 1024));
+        let other = Context::with_memory_pool(
+            &Resources {
+                memory_mb: 256.into(),
+                workers: 1,
+                ..Default::default()
+            },
+            Arc::new(AtomicBool::new(false)),
+            Arc::new(|_| {}),
+            pool.clone(),
+        )?;
+        let held = Arc::new(Mutex::new(Reservation::new(&other)));
+        let grant = held.clone();
+        let shared = pool.clone();
+        let visits = Arc::new(AtomicUsize::new(0));
+        let input_visits = visits.clone();
+        let injected = Arc::new(AtomicBool::new(false));
+        let did_inject = injected.clone();
+        let result = run_with_memory_pool(
+            job.clone(),
+            Arc::new(AtomicBool::new(false)),
+            Arc::new(move |progress| {
+                if progress.phase == "Reading and validating CSV" && progress.rows == 0 {
+                    input_visits.fetch_add(1, Ordering::Relaxed);
+                }
+                if progress.phase == phase && !did_inject.swap(true, Ordering::Relaxed) {
+                    let usage = shared.usage();
+                    grant
+                        .lock()
+                        .unwrap()
+                        .resize((usage.limit_bytes - usage.reserved_bytes - 256) as usize)
+                        .unwrap();
+                }
+            }),
+            pool.clone(),
+        );
+        assert!(
+            injected.load(Ordering::Relaxed),
+            "phase not reached: {phase}"
+        );
+        if phase == "Finalizing direct terminal output" {
+            let error = result
+                .map(|_| ())
+                .expect_err("finalization admission must fail");
+            assert!(
+                format!("{error:#}").contains("shared process memory admission"),
+                "{error:#}"
+            );
+        } else {
+            // Resident emission releases row grants after injection; the fixed
+            // competitor need not deny later manifest construction.
+            let analysis = result?;
+            assert_eq!(analysis.rows, 65537);
+            assert_eq!(analysis.output_files, 2);
+            drop(analysis);
+            fs::remove_dir_all(&job.output)?;
+        }
+        assert_eq!(
+            visits.load(Ordering::Relaxed),
+            1,
+            "consumed input must not replay"
+        );
+        clean(dir.path(), &job)?;
+        drop(held);
+        drop(other);
+        assert_eq!(pool.usage().reserved_bytes, 0);
+    }
+    Ok(())
+}
