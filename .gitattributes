# Keep source and documentation identical in Windows and Linux checkouts.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
# CSV fixture bytes (including line endings) are part of their input contract.
*.csv -text
# The archived v0.4.0 example includes CRLF record endings.
scripts/fixtures/release-upgrade/v0.4.0/examples/customers.csv whitespace=cr-at-eol

# Evidence hashes and catalog validation must survive Windows text checkouts.
docs/benchmarks/** -text
docs/benchmarks/*.md text eol=lf
docs/performance.md text eol=lf
scripts/summarize-performance-decisions.py text eol=lf
scripts/audit-strategy-evidence.py text eol=lf
docs/evidence-registry.v1.json text eol=lf
docs/evidence-originals.md text eol=lf
# Preserve the audited upstream copy and local patch identities.
vendor/zip-2.4.2/** -text
# Keep rejected experiment snapshots byte-for-byte, outside executable sources.
docs/history/rejected-sort-experiments-2026-10-24/*.rs.txt -text
docs/history/rejected-parallel-groups-2026-10-25/*.rs -text
docs/history/rejected-parallel-groups-2026-10-25/*.py -text
scripts/build-browser.sh text eol=lf

# E3 historical source and exact-byte R24 report copies retain their pinned bytes.
docs/history/rejected-input-snapshots-2026-10-26/** -text
docs/benchmarks/e3-direct-r24-2026-10-26-*.md -text
scripts/graphify.sh text eol=lf

# Distribution notices include verbatim upstream license/runtime texts.
docs/releases/native-usage.txt -text whitespace=-blank-at-eol
