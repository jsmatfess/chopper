from collections.abc import Iterator
from os import PathLike
from types import TracebackType
from typing import Any, Final, Self

_DEFAULT_MANIFEST_RECORD_BYTES: Final[int]

class ChopperError(Exception):
    code: str
    path: str | None
    line: int | None
    column: int | None

class ExecutionControl:
    def cancel(self) -> None: ...
    def progress(self) -> dict[str, Any]: ...

class NativeJob:
    @staticmethod
    def from_json(source: str) -> NativeJob: ...
    @staticmethod
    def load(path: str | PathLike[str]) -> NativeJob: ...
    def save(self, path: str | PathLike[str]) -> None: ...
    def to_dict(self) -> dict[str, Any]: ...
    def validate(self) -> None: ...
    def inspect(self) -> dict[str, Any]: ...
    def preview(self) -> dict[str, Any]: ...
    def detect_dialect(self) -> dict[str, Any]: ...
    def analyze(self, control: ExecutionControl | None = None) -> dict[str, Any]: ...
    def run(self, control: ExecutionControl | None = None) -> dict[str, Any]: ...

class ManifestReader(Iterator[dict[str, Any]]):
    @property
    def header(self) -> dict[str, Any]: ...
    def __iter__(self) -> Self: ...
    def __next__(self) -> dict[str, Any]: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        kind: type[BaseException] | None,
        value: BaseException | None,
        traceback: TracebackType | None,
    ) -> None: ...
    def close(self) -> None: ...

def _validate_formula(source: str) -> None: ...
def formula_functions() -> list[tuple[str, str]]: ...
def open_manifest(
    path: str | PathLike[str], *, max_record_bytes: int = ...,
) -> ManifestReader: ...
